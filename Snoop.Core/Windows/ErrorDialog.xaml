<windows:SnoopBaseWindow x:Class="Snoop.Windows.ErrorDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:localization="clr-namespace:Snoop.Localization"
                         xmlns:windows="clr-namespace:Snoop.Windows"
                         Width="640"
                         Height="480"
                         MinWidth="640"
                         MinHeight="480"
                         ResizeMode="CanResizeWithGrip">
    <Window.Title>
        <Binding Path="[ErrorDialog.DefaultTitle]"
                 Source="{x:Static localization:InspectorLocalization.Default}"
                 Mode="OneWay"
                 StringFormat="{}{0} - Snoop" />
    </Window.Title>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="captionTextBlock"
                   Grid.Row="0"
                   FontSize="16"
                   Foreground="{DynamicResource Snoop.Brushes.Default.Foreground}"
                   Text="{localization:InspectorLoc ErrorDialog.DefaultCaption}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="errorDetailsLabel"
                   Grid.Row="1"
                   Margin="0 10 0 0"
                   Text="{localization:InspectorLoc ErrorDialog.Details}" />
        <TextBox x:Name="_textBlockException"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3"
                    Margin="0 5 0 0">
            <TextBlock Text="{localization:InspectorLoc ErrorDialog.ReviewDetails}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0 5 0 0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <Button x:Name="_buttonCopyToClipboard"
                    Width="175"
                    Height="32"
                    Margin="0 0 15 0"
                    Click="ButtonCopyToClipboard_Click">
                <TextBlock Text="{localization:InspectorLoc ErrorDialog.CopyDetails}" />
            </Button>
            <StackPanel Grid.Row="3"
                        Orientation="Vertical">
                <TextBlock>
                    <Hyperlink NavigateUri="dummy"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <TextBlock Text="{localization:InspectorLoc ErrorDialog.CreateIssue}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="HandledExceptionPanel"
                    Grid.Row="5"
                    Margin="0 5 0 0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <Button Width="230"
                    Height="32"
                    Click="CloseAndMarkHandled_Click"
                    IsCancel="True"
                    IsDefault="True">
                <TextBlock Text="{localization:InspectorLoc ErrorDialog.Close}" />
                <Button.ToolTip>
                    <TextBlock MaxWidth="300"
                               Text="{localization:InspectorLoc ErrorDialog.MarkHandledTip}"
                               TextWrapping="Wrap" />
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <StackPanel x:Name="UnhandledExceptionPanel"
                    Grid.Row="5"
                    Margin="0 5 0 0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <CheckBox x:Name="_checkBoxRemember"
                      Grid.Row="5"
                      Margin="0 0 5 0"
                      VerticalAlignment="Center"
                      ToolTipService.ShowDuration="30000">
                <TextBlock Text="{localization:InspectorLoc ErrorDialog.Remember}" />
                <CheckBox.ToolTip>
                    <TextBlock MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Inlines>
                            <Run Text="{localization:InspectorLoc ErrorDialog.RememberTip}" />
                            <LineBreak />
                            <LineBreak />
                            <Run Text="{localization:InspectorLoc ErrorDialog.RememberUntilReattachTip}" />
                        </TextBlock.Inlines>
                    </TextBlock>
                </CheckBox.ToolTip>
            </CheckBox>
            <Button Width="230"
                    Height="32"
                    Margin="0 0 10 0"
                    Click="CloseDoNotMarkHandled_Click">
                <TextBlock Text="{localization:InspectorLoc ErrorDialog.CloseWithoutHandling}" />
                <Button.ToolTip>
                    <TextBlock MaxWidth="300"
                               Text="{localization:InspectorLoc ErrorDialog.CloseWithoutHandlingTip}"
                               TextWrapping="Wrap" />
                </Button.ToolTip>
            </Button>
            <Button Width="230"
                    Height="32"
                    Click="CloseAndMarkHandled_Click"
                    IsCancel="True"
                    IsDefault="True">
                <TextBlock Text="{localization:InspectorLoc ErrorDialog.CloseAndMarkHandled}" />
                <Button.ToolTip>
                    <TextBlock MaxWidth="300"
                               Text="{localization:InspectorLoc ErrorDialog.MarkHandledTip}"
                               TextWrapping="Wrap" />
                </Button.ToolTip>
            </Button>
        </StackPanel>
    </Grid>
</windows:SnoopBaseWindow>
