<windows:SnoopBaseWindow x:Class="Snoop.Windows.EditUserFilters"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:converters="clr-namespace:Snoop.Converters"
                         xmlns:localization="clr-namespace:Snoop.Localization"
                         xmlns:windows="clr-namespace:Snoop.Windows"
                         x:Name="editUserFilters"
                         Title="{localization:InspectorLoc FilterEditor.Title}"
                         Width="520" Height="390" MinWidth="380" MinHeight="320"
                         FontFamily="{DynamicResource SnoopNext.FontFamily.UI}"
                         FontSize="{DynamicResource SnoopNext.FontSize.UI}">
    <Grid x:Name="FormSurface">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="filterSetList"
                     ItemsSource="{Binding ItemsSource, ElementName=editUserFilters}"
                     SelectionChanged="SelectionChangedHandler">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="6,3" Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="1" Margin="0,8,0,12" LastChildFill="False">
                <Button x:Name="AddItem" DockPanel.Dock="Left" MinWidth="76" MinHeight="32" Padding="12,4"
                        Click="AddHandler" Content="{localization:InspectorLoc FilterEditor.AddNew}" />
                <Button x:Name="DeleteItem" DockPanel.Dock="Left" MinWidth="76" MinHeight="32" Padding="12,4" Margin="6,0,0,0"
                        Click="DeleteHandler" Content="{localization:InspectorLoc Common.Delete}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MoveUp" MinWidth="36" MinHeight="32" Padding="9,5"
                            AutomationProperties.Name="{localization:InspectorLoc FilterEditor.MoveUp}"
                            ToolTip="{localization:InspectorLoc FilterEditor.MoveUp}" Click="UpHandler">
                        <Image Width="14" Height="14" Source="{DynamicResource upDrawingImage}" />
                    </Button>
                    <Button x:Name="MoveDown" MinWidth="36" MinHeight="32" Padding="9,5" Margin="6,0,0,0"
                            AutomationProperties.Name="{localization:InspectorLoc FilterEditor.MoveDown}"
                            ToolTip="{localization:InspectorLoc FilterEditor.MoveDown}" Click="DownHandler">
                        <Image Width="14" Height="14" Source="{DynamicResource downDrawingImage}" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label x:Name="NameLabel" Padding="0,0,12,0" VerticalAlignment="Center"
                       Content="{localization:InspectorLoc FilterEditor.Name}" Target="{Binding ElementName=NameEditor}" />
                <TextBox x:Name="NameEditor" Grid.Column="1" MinHeight="32" Padding="8,3" VerticalContentAlignment="Center"
                         AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                         IsReadOnly="{Binding SelectedItem.IsReadOnly, ElementName=filterSetList}" IsReadOnlyCaretVisible="True"
                         Text="{Binding SelectedItem.DisplayName, ElementName=filterSetList}" />
                <Label x:Name="PropertiesLabel" Grid.Row="1" Margin="0,6,0,0" Padding="0,0,12,0" VerticalAlignment="Center"
                       Content="{localization:InspectorLoc FilterEditor.Properties}" Target="{Binding ElementName=PropertiesEditor}" />
                <TextBox x:Name="PropertiesEditor" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MinHeight="32"
                         Padding="8,3" VerticalContentAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=PropertiesLabel}"
                         IsReadOnly="{Binding SelectedItem.IsReadOnly, ElementName=filterSetList}" IsReadOnlyCaretVisible="True"
                         Text="{Binding SelectedItem.Properties, ElementName=filterSetList, Converter={x:Static converters:CsvStringToArrayConverter.Default}}" />
            </Grid>
        </Grid>
        <Border Grid.Row="1" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SnoopNext.Brush.Border}" Background="{DynamicResource SnoopNext.Brush.Panel}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="Accept" MinWidth="88" MinHeight="32" Padding="14,4" IsDefault="True"
                        Click="OkHandler" Content="{localization:InspectorLoc Common.OK}" />
                <Button x:Name="Cancel" MinWidth="88" MinHeight="32" Padding="14,4" Margin="8,0,0,0" IsCancel="True"
                        Click="CancelHandler" Content="{localization:InspectorLoc Common.Cancel}" />
            </StackPanel>
        </Border>
    </Grid>
</windows:SnoopBaseWindow>
