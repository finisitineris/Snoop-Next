<windows:SnoopMainBaseWindow x:Class="Snoop.Windows.SnoopUI"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:behaviorsTab="clr-namespace:Snoop.Views.BehaviorsTab"
                             xmlns:controls="clr-namespace:Snoop.Controls"
                             xmlns:converters="clr-namespace:Snoop.Converters"
                             xmlns:core="clr-namespace:Snoop.Core"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:debugListenerTab="clr-namespace:Snoop.Views.DebugListenerTab"
                             xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:methodsTab="clr-namespace:Snoop.Views.MethodsTab"
                             xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                             xmlns:powerShell="clr-namespace:Snoop.PowerShell"
                             xmlns:selectionHighlight="clr-namespace:Snoop.Infrastructure.SelectionHighlight"
                             xmlns:localization="clr-namespace:Snoop.Localization"
                             xmlns:snoop="clr-namespace:Snoop"
                             xmlns:tree="clr-namespace:Snoop.Data.Tree"
                             xmlns:triggersTab="clr-namespace:Snoop.Views.TriggersTab"
                             xmlns:views="clr-namespace:Snoop.Views"
                             xmlns:windows="clr-namespace:Snoop.Windows"
                             Title="Snoop"
                             MinWidth="480"
                             MinHeight="360"
                             d:DesignHeight="480"
                             d:DesignWidth="640"
                             DataContext="{Binding RelativeSource={RelativeSource Self}}"
                             Focusable="False"
                             ShowInTaskbar="True"
                             SnapsToDevicePixels="True"
                             mc:Ignorable="options d">
    <windows:SnoopMainBaseWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SnoopNext.WorkbenchFocusVisual" TargetType="{x:Type Control}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Control}">
                            <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Rectangle x:Name="HighContrastUnderlay"
                                           Stroke="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                           StrokeThickness="4"
                                           Visibility="Collapsed" />
                                <Rectangle x:Name="FocusOutline"
                                           Stroke="{DynamicResource SnoopNext.Brush.Accent}"
                                           StrokeThickness="2" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                    <Setter TargetName="HighContrastUnderlay" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="FocusOutline"
                                            Property="Stroke"
                                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                    <Setter TargetName="FocusOutline" Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SnoopNext.WorkbenchNavigationButton" TargetType="{x:Type Button}">
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource SnoopNext.WorkbenchFocusVisual}" />
                <Setter Property="Margin" Value="0 0 0 3" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SnoopNext.WorkbenchNavigationGlyph" TargetType="{x:Type Path}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>

            <DataTemplate x:Key="stylelessTextBlockDataTemplate">
                <TextBlock Text="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </windows:SnoopMainBaseWindow.Resources>

    <DockPanel x:Name="WorkbenchChrome" Background="{DynamicResource SnoopNext.Brush.Background}">
        <StackPanel x:Name="WorkbenchHeader" DockPanel.Dock="Top">
            <Menu x:Name="WorkbenchMenuBar"
                  Background="{DynamicResource SnoopNext.Brush.Panel}"
                  BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                  BorderThickness="0 0 0 1">
                <MenuItem x:Name="FileMenuItem" Header="{localization:InspectorLoc Menu.File}">
                    <MenuItem Header="{localization:InspectorLoc Menu.CloseWindow}"
                              Command="{x:Static ApplicationCommands.Close}" />
                </MenuItem>
                <MenuItem x:Name="WorkbenchViewMenu" Header="{localization:InspectorLoc Menu.View}">
                    <MenuItem x:Name="ShowTreePaneItem"
                              Header="{localization:InspectorLoc Workbench.ShowTree}"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="HandleToggleWorkbenchPane_OnClick" />
                    <MenuItem x:Name="ShowPropertiesPaneItem"
                              Header="{localization:InspectorLoc Workbench.ShowProperties}"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="HandleToggleWorkbenchPane_OnClick" />
                    <MenuItem x:Name="ShowDiagnosticsPaneItem"
                              Header="{localization:InspectorLoc Workbench.ShowDiagnostics}"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="HandleToggleWorkbenchPane_OnClick" />
                </MenuItem>
                <MenuItem Header="{localization:InspectorLoc Menu.Settings}">
                    <MenuItem Header="{Binding Path=SettingsFile, Source={x:Static core:Settings.Default}}" />
                    <MenuItem Header="{localization:InspectorLoc Menu.MakeSettingsApplicationSpecific}"
                              Click="HandleMakeSettingsApplicationsSpecific_OnClick" />
                    <MenuItem Header="{localization:InspectorLoc Menu.DeleteApplicationSpecificSettings}"
                              Click="HandleDeleteApplicationSpecificSettings_OnClick" />
                    <MenuItem Header="{localization:InspectorLoc Menu.OpenSettingsFolder}"
                              Click="HandleOpenSettingsFolder_OnClick" />
                    <Separator />
                    <MenuItem x:Name="WorkbenchDensityMenu" Header="{localization:InspectorLoc Density.Label}">
                        <MenuItem x:Name="ComfortableDensityItem"
                                  Header="{localization:InspectorLoc Density.Comfortable}"
                                  Tag="{x:Static core:Settings.ComfortableDensity}"
                                  Click="HandleSetWorkbenchDensity_OnClick">
                            <MenuItem.Style>
                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkbenchDensity, Source={x:Static core:Settings.Default}}"
                                                     Value="{x:Static core:Settings.ComfortableDensity}">
                                            <Setter Property="IsChecked" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem x:Name="CompactDensityItem"
                                  Header="{localization:InspectorLoc Density.Compact}"
                                  Tag="{x:Static core:Settings.CompactDensity}"
                                  Click="HandleSetWorkbenchDensity_OnClick">
                            <MenuItem.Style>
                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkbenchDensity, Source={x:Static core:Settings.Default}}"
                                                     Value="{x:Static core:Settings.CompactDensity}">
                                            <Setter Property="IsChecked" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="WorkbenchLayoutMenu"
                              Header="{localization:InspectorLoc Workbench.Layout}"
                              SubmenuOpened="HandleWorkbenchLayoutMenuOpened">
                        <MenuItem x:Name="DefaultWorkbenchLayoutItem"
                                  Header="{localization:InspectorLoc Workbench.LayoutDefault}"
                                  Click="HandleResetWorkbenchLayout_OnClick" />
                        <MenuItem x:Name="PreviewWorkbenchLayoutItem"
                                  Header="{localization:InspectorLoc Workbench.LayoutPreview}"
                                  Click="HandlePreviewWorkbenchLayout_OnClick" />
                        <MenuItem x:Name="PropertiesWorkbenchLayoutItem"
                                  Header="{localization:InspectorLoc Workbench.LayoutProperties}"
                                  Click="HandlePropertiesWorkbenchLayout_OnClick" />
                        <MenuItem x:Name="CustomWorkbenchLayoutItem"
                                  Header="{localization:InspectorLoc Workbench.LayoutCustom}"
                                  IsEnabled="False"
                                  Visibility="Collapsed" />
                    </MenuItem>
                    <MenuItem x:Name="ResetWorkbenchLayoutItem"
                              Header="{localization:InspectorLoc Workbench.ResetLayout}"
                              Click="HandleResetWorkbenchLayout_OnClick" />
                    <MenuItem Header="{localization:InspectorLoc Menu.ResetSettings}"
                              Click="HandleResetSettings_OnClick" />
                </MenuItem>
                <MenuItem Header="{localization:InspectorLoc Menu.TrackingOptions}">
                    <MenuItem Header="{localization:InspectorLoc Menu.TrackOnMouseMove}"
                              IsCheckable="True"
                              IsChecked="{Binding TrackOnMouseMove}"
                              ToolTip="{localization:InspectorLoc Tooltip.TrackOnMouseMove}" />
                    <MenuItem Header="{localization:InspectorLoc Menu.TrackOnClick}"
                              IsCheckable="True"
                              IsChecked="{Binding TrackOnClick}"
                              ToolTip="{localization:InspectorLoc Tooltip.TrackOnClick}" />
                    <MenuItem Header="{localization:InspectorLoc Menu.SkipTemplateParts}"
                              IsCheckable="True"
                              IsChecked="{Binding SkipTemplateParts}"
                              ToolTip="{localization:InspectorLoc Tooltip.SkipTemplateParts}" />
                    <MenuItem Header="{localization:InspectorLoc Menu.IgnoreHitTestVisibility}"
                              IsCheckable="True"
                              IsChecked="{Binding IgnoreHitTestVisibility}"
                              ToolTip="{localization:InspectorLoc Tooltip.IgnoreHitTestVisibility}" />
                    <Separator />
                    <MenuItem Header="{localization:InspectorLoc Menu.HighlightSelectedItem}"
                              IsCheckable="True"
                              IsChecked="{Binding HighlightSelectedItem, Source={x:Static selectionHighlight:SelectionHighlightOptions.Default}}" />
                    <MenuItem Header="{localization:InspectorLoc Menu.HighlightOptions}"
                              Click="HandleHighlightOptions_OnClick" />
                </MenuItem>
                <MenuItem Header="{localization:InspectorLoc Menu.Debug}">
                    <MenuItem Header="{localization:InspectorLoc Menu.LaunchDebugger}"
                              Click="HandleLaunchDebugger_OnClick" />
                    <MenuItem x:Name="InspectSnoopMenuItem"
                              Header="{localization:InspectorLoc Menu.SnoopSnoop}"
                              Click="HandleSnoopSnoop_OnClick" />
                </MenuItem>
                <MenuItem Header="?">
                    <MenuItem Click="HandleSnoopVersion_OnClick">
                        <MenuItem.Header>
                            <TextBlock x:Name="SnoopVersionHeader">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="[Menu.Version]"
                                                 Source="{x:Static localization:InspectorLocalization.Default}"
                                                 Mode="OneWay" />
                                        <Binding Source="{x:Static windows:SnoopUI.AssemblyVersion}" Mode="OneTime" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
            </Menu>
            <Border x:Name="WorkbenchCommandBar"
                    Padding="8 4"
                    Background="{DynamicResource SnoopNext.Brush.Panel}"
                    BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                    BorderThickness="0 0 0 1">
                <WrapPanel>
                    <Button x:Name="RefreshTreeButton"
                            MinHeight="28"
                            Margin="0 2 8 2"
                            Padding="8 2"
                            Content="{localization:InspectorLoc Workbench.RefreshTree}"
                            ToolTip="{localization:InspectorLoc Tooltip.RefreshTree}"
                            FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                            Command="{x:Static windows:SnoopUI.RefreshCommand}" />
                    <Button x:Name="CommandPaletteButton"
                            MinHeight="28"
                            Margin="0 2 8 2"
                            Padding="8 2"
                            Content="{localization:InspectorLoc CommandPalette.Title}"
                            ToolTip="{localization:InspectorLoc CommandPalette.Tooltip}"
                            FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                            Command="{x:Static windows:SnoopUI.OpenCommandPaletteCommand}" />
                    <Popup x:Name="WorkbenchCommandPalette"
                           PlacementTarget="{Binding ElementName=CommandPaletteButton}"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="False"
                           Opened="HandleCommandPaletteOpened"
                           Closed="HandleCommandPaletteClosed">
                        <Border x:Name="CommandPaletteSurface"
                                Width="320"
                                Padding="10"
                                Background="{DynamicResource SnoopNext.Brush.Panel}"
                                BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                                BorderThickness="1"
                                FocusManager.IsFocusScope="True"
                                KeyboardNavigation.TabNavigation="Cycle"
                                PreviewKeyDown="HandleCommandPalettePreviewKeyDown">
                            <StackPanel>
                                <Label Padding="0 0 0 4"
                                       Content="{localization:InspectorLoc CommandPalette.Search}"
                                       Target="{Binding ElementName=WorkbenchCommandQuery}" />
                                <TextBox x:Name="WorkbenchCommandQuery"
                                         MinHeight="28"
                                         Padding="4 2"
                                         FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}" />
                                <ListBox x:Name="WorkbenchCommandResults"
                                         Margin="0 4 0 0"
                                         MaxHeight="190"
                                         AutomationProperties.Name="{localization:InspectorLoc CommandPalette.Title}"
                                         DisplayMemberPath="Caption"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource SnoopNext.WorkbenchFocusVisual}" />
                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HandleCommandPaletteItemClick" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="WorkbenchCommandNoResults"
                                           Margin="4 4 0 0"
                                           Foreground="{DynamicResource SnoopNext.Brush.Text}"
                                           Text="{localization:InspectorLoc CommandPalette.Empty}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=WorkbenchCommandResults}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label x:Name="TreeHeaderLabel"
                               Padding="2 2 4 2"
                               VerticalAlignment="Center"
                               Content="{localization:InspectorLoc Tree.Label}"
                               Target="{Binding ElementName=TreeTypeComboBox}" />
                        <ComboBox x:Name="TreeTypeComboBox"
                                  MinHeight="28"
                                  Margin="0 2 8 2"
                                  Padding="4 2"
                                  FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                                  ItemsSource="{Binding Source={snoop:EnumBindingSource {x:Type tree:TreeType}}}"
                                  SelectedItem="{Binding CurrentTreeType, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Padding="2 2 4 2"
                               VerticalAlignment="Center"
                               Content="{localization:InspectorLoc Theme.Label}"
                               Target="{Binding ElementName=ThemeComboBox}" />
                        <ComboBox x:Name="ThemeComboBox"
                                  MinHeight="28"
                                  Margin="0 2"
                                  Padding="4 2"
                                  FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                                  ItemsSource="{Binding Source={snoop:EnumBindingSource {x:Type core:ThemeMode}}}"
                                  SelectedItem="{Binding ThemeMode, Source={x:Static core:Settings.Default}, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <Border x:Name="WorkbenchNavigationRail"
                DockPanel.Dock="Left"
                Width="51"
                Background="{DynamicResource SnoopNext.Brush.Panel}"
                BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                BorderThickness="0 0 1 0">
            <ScrollViewer Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4 7">
                    <Button x:Name="NavigateTreeButton"
                            Style="{StaticResource SnoopNext.WorkbenchNavigationButton}"
                            ToolTip="{localization:InspectorLoc Workbench.ShowTree}"
                            Click="HandleNavigateToTree_OnClick">
                        <Path Style="{StaticResource SnoopNext.WorkbenchNavigationGlyph}"
                              Data="M2,2 H7 V7 H2 Z M4.5,7 V13 H9 M9,10.5 H14 V15.5 H9 Z" />
                    </Button>
                    <Button x:Name="NavigatePropertiesButton"
                            Style="{StaticResource SnoopNext.WorkbenchNavigationButton}"
                            ToolTip="{localization:InspectorLoc Tab.Properties}"
                            Click="HandleNavigateToProperties_OnClick">
                        <Path Style="{StaticResource SnoopNext.WorkbenchNavigationGlyph}"
                              Data="M2,4 H16 M2,9 H16 M2,14 H16 M6,2 V6 M12,7 V11 M7,12 V16" />
                    </Button>
                    <Button x:Name="NavigateDiagnosticsButton"
                            Style="{StaticResource SnoopNext.WorkbenchNavigationButton}"
                            ToolTip="{localization:InspectorLoc Tab.Diagnostics}"
                            Click="HandleNavigateToDiagnostics_OnClick">
                        <Path Style="{StaticResource SnoopNext.WorkbenchNavigationGlyph}"
                              Data="M9,2 L16,15 H2 Z M9,6 V10 M9,12 V12.5" />
                    </Button>
                    <Button x:Name="NavigateEventsButton"
                            Style="{StaticResource SnoopNext.WorkbenchNavigationButton}"
                            ToolTip="{localization:InspectorLoc Tab.Events}"
                            Click="HandleNavigateToEvents_OnClick">
                        <Path Style="{StaticResource SnoopNext.WorkbenchNavigationGlyph}"
                              Data="M10,1 L3,10 H8 L7,17 L15,7 H10 Z" />
                    </Button>
                    <Button x:Name="NavigatePreviewButton"
                            Style="{StaticResource SnoopNext.WorkbenchNavigationButton}"
                            ToolTip="{localization:InspectorLoc Tab.Preview}"
                            Click="HandleNavigateToPreview_OnClick">
                        <Path Style="{StaticResource SnoopNext.WorkbenchNavigationGlyph}"
                              Data="M2,3 H16 V13 H2 Z M6,16 H12 M9,13 V16" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="WorkbenchGrid">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreePaneColumn" Width="282" />
                <ColumnDefinition x:Name="TreeSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="CenterPaneColumn" />
                <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="InspectorPaneColumn" Width="354" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="TreeWorkbenchPane" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Filter Combo Box -->
                <ComboBox x:Name="filterComboBox"
                          Margin="2"
                          infrastructure:ComboBoxSettings.RegisterAsSnoopPart="True"
                          IsEditable="True"
                          Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem x:Name="ClearTreeFilterItem"
                                  Content="{localization:InspectorLoc Tooltip.ClearFilter}" />
                    <ComboBoxItem x:Name="BindingErrorsFilterItem"
                                  Content="{localization:InspectorLoc Tooltip.ShowBindingErrors}" />
                    <ComboBox.ToolTip>
                        <TextBlock Text="{localization:InspectorLoc Tooltip.FilterByNameOrType}" />
                    </ComboBox.ToolTip>
                </ComboBox>

                <!-- Visual Tree TreeView -->
                <controls:ProperTreeView x:Name="Tree"
                                         Style="{DynamicResource Snoop.Styles.ProperTreeView}"
                                         Grid.Row="1"
                                         MinWidth="0"
                                         MinHeight="0"
                                         Margin="2 0 2 0"
                                         HorizontalAlignment="Stretch"
                                         ItemsSource="{Binding TreeItems}">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type tree:TreeItem}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock HorizontalAlignment="Stretch"
                                       infrastructure:BringIntoViewBehavior.IsActive="{Binding IsSelected}"
                                       Background="Transparent"
                                       Text="{Binding}" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type controls:ProperTreeViewItem}"
                               BasedOn="{StaticResource ProperTreeViewItemStyle}">
                            <!-- <Setter Property="Background" Value="{Binding TreeBackgroundBrush}" /> -->

                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu ItemsSource="{Binding MenuItems}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="1 2 0 2" />
                            <Setter Property="ToolTip" Value="{Binding VisualBrush}" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkbenchDensity, Source={x:Static core:Settings.Default}}"
                                             Value="{x:Static core:Settings.CompactDensity}">
                                    <Setter Property="Padding" Value="1 0 0 0" />
                                </DataTrigger>
                            </Style.Triggers>

                            <Style.Resources>
                                <Style TargetType="{x:Type ToolTip}"
                                       BasedOn="{StaticResource {x:Type ToolTip}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToolTip}">
                                                <Grid Width="200"
                                                      Height="200">
                                                    <Rectangle Margin="10"
                                                               Fill="{TemplateBinding Content}"
                                                               RadiusX="10"
                                                               RadiusY="10" />

                                                    <Grid.Effect>
                                                        <DropShadowEffect />
                                                    </Grid.Effect>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Style.Resources>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <controls:ProperTreeView.ToolTip>
                        <TextBlock Text="{localization:InspectorLoc Tooltip.TreeSelect}" />
                    </controls:ProperTreeView.ToolTip>
                </controls:ProperTreeView>
            </Grid>

            <GridSplitter x:Name="GridSplitter"
                          Grid.Column="1"
                          AutomationProperties.Name="{localization:InspectorLoc Tree.Label}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <GridSplitter x:Name="PropertiesSplitter"
                          Grid.Column="3"
                          AutomationProperties.Name="{localization:InspectorLoc Tab.Properties}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <TabControl x:Name="PropertiesWorkbenchPane"
                        Grid.Column="4"
                        Margin="2 2 2 0"
                        ClipToBounds="True">
                <TabItem x:Name="WorkbenchPropertiesTab">
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.Properties}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.PropertiesTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.PropertiesDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <controls:PropertyInspector x:Name="PropertyInspector"
                                                RootTarget="{Binding CurrentSelection.Target}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.DataContext}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.DataContextTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.DataContextDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <controls:PropertyInspector x:Name="DataContextPropertyGrid"
                                                RootTarget="{Binding CurrentSelection.Target, Converter={x:Static converters:DataContextExtractorConverter.Instance}}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.Triggers}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.TriggersTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.TriggersDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <triggersTab:TriggersView IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                              RootTarget="{Binding CurrentSelection.Target}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.Behaviors}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.BehaviorsTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.BehaviorsDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <behaviorsTab:BehaviorsView IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                                RootTarget="{Binding CurrentSelection.Target}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.Methods}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.MethodsTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.MethodsDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <methodsTab:MethodsControl IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                               RootTarget="{Binding CurrentSelection.Target}" />
                </TabItem>

                <TabItem Visibility="{Binding Converter={x:Static converters:IsPowerShellAvailableToVisibilityConverter.DefaultInstance}}">
                    <TabItem.Header>
                        <TextBlock Text="{localization:InspectorLoc Tab.PowerShell}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.PowerShellTitle}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.PowerShellDescription}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </TabItem.Header>

                    <powerShell:EmbeddedShellView IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                </TabItem>

            </TabControl>

            <Grid x:Name="WorkbenchCenterGrid" Grid.Column="2" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewPaneRow" />
                    <RowDefinition x:Name="DiagnosticsSplitterRow" Height="5" />
                    <RowDefinition x:Name="DiagnosticsPaneRow" Height="210" />
                </Grid.RowDefinitions>

                <Grid x:Name="WorkbenchPreviewPane"
                      AutomationProperties.Name="{localization:InspectorLoc Tab.Preview}"
                      Focusable="True"
                      FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                      KeyboardNavigation.IsTabStop="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="6 4" ClipToBounds="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0 0 10 0"
                                   Foreground="{DynamicResource SnoopNext.Brush.Text}"
                                   Text="{localization:InspectorLoc Tab.Preview}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="300"
                                           Text="{localization:InspectorLoc Tooltip.PreviewDescription}"
                                           TextWrapping="Wrap" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="WorkbenchPreviewSelectionPath"
                                   Foreground="{DynamicResource SnoopNext.Brush.Text}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock MaxWidth="420"
                                               Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                                               TextWrapping="Wrap" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{Binding PreviewSelectionPath, Mode=OneWay}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSelection}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{localization:InspectorLoc Status.NoSelection}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <controls:Previewer x:Name="PreviewArea"
                                        Grid.Row="1"
                                        Target="{Binding CurrentSelection.Target}" />
                </Grid>

                <GridSplitter x:Name="DiagnosticsSplitter"
                              Grid.Row="1"
                              AutomationProperties.Name="{localization:InspectorLoc Tab.Diagnostics}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              FocusVisualStyle="{StaticResource SnoopNext.WorkbenchFocusVisual}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

                <TabControl x:Name="DiagnosticsWorkbenchPane"
                            Grid.Row="2">
                    <TabItem x:Name="WorkbenchDiagnosticsTab">
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="{localization:InspectorLoc Tab.Diagnostics}" />
                                <Run Text=" (" />
                                <Run Text="{Binding TreeService.DiagnosticContext.DiagnosticItems.Count, Mode=OneWay}" />
                                <Run Text=")" />
                                <TextBlock.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <TextBlock Text="{localization:InspectorLoc Tab.Diagnostics}" />
                                        <TextBlock Text="{localization:InspectorLoc Tooltip.DiagnosticsDescription}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </TabItem.Header>

                        <views:DiagnosticsView x:Name="WorkbenchDiagnosticsView"
                                               DiagnosticContext="{Binding TreeService.DiagnosticContext}" />
                    </TabItem>

                    <TabItem x:Name="WorkbenchEventsTab">
                        <TabItem.Header>
                            <TextBlock Text="{localization:InspectorLoc Tab.Events}">
                                <TextBlock.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <TextBlock Text="{localization:InspectorLoc Tooltip.EventsTitle}" />
                                        <TextBlock Text="{localization:InspectorLoc Tooltip.EventsDescription}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </TabItem.Header>

                        <views:EventsView x:Name="eventsView" />
                    </TabItem>

                    <TabItem x:Name="WorkbenchOutputTab">
                        <TabItem.Header>
                            <TextBlock Text="{localization:InspectorLoc Tab.Output}">
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="300"
                                               Text="{localization:InspectorLoc Tooltip.DebugListenerDescription}"
                                               TextWrapping="Wrap" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </TabItem.Header>

                        <debugListenerTab:DebugListenerControl x:Name="debugListenerControl" />
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- StatusBar -->
            <StatusBar x:Name="WorkbenchStatusBar"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Background="{DynamicResource SnoopNext.Brush.Panel}"
                       BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                       BorderThickness="0 1 0 0"
                       Foreground="{DynamicResource SnoopNext.Brush.Text}">
                <StatusBarItem HorizontalContentAlignment="Stretch" Padding="4 2">
                    <Grid x:Name="WorkbenchStatusContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0 0 8 0">
                            <TextBlock x:Name="WorkbenchTargetLabel"
                                       DockPanel.Dock="Left"
                                       Margin="0 0 4 0"
                                       Text="{localization:InspectorLoc Status.TargetProcess}" />
                            <TextBlock x:Name="WorkbenchTargetValue"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="{Binding InspectedProcess, Mode=OneWay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RootTreeItem}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{localization:InspectorLoc Status.NoTarget}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <DockPanel Grid.Column="1">
                            <TextBlock x:Name="WorkbenchSelectionLabel"
                                       DockPanel.Dock="Left"
                                       Margin="0 0 4 0"
                                       Text="{localization:InspectorLoc Status.SelectedElement}" />
                            <TextBlock x:Name="WorkbenchSelectionValue"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="{Binding CurrentSelection.DisplayName, Mode=OneWay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSelection}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{localization:InspectorLoc Status.NoSelection}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Margin="0 1 8 0" TextTrimming="CharacterEllipsis">
                            <Run Text="{localization:InspectorLoc Status.KeyboardFocusedElement}" /><Run Text=" " />
                            <controls:NoFocusHyperlink x:Name="WorkbenchSelectFocusLink"
                                                       Command="{x:Static windows:SnoopUI.SelectFocusCommand}"
                                                       CommandParameter="{Binding CurrentFocus}"
                                                       Focusable="False">
                                <Run Text="{Binding CurrentFocus, Converter={x:Static converters:ObjectToStringConverter.Instance}, Mode=OneWay}" />
                            </controls:NoFocusHyperlink>
                            <TextBlock.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.KeyboardFocusDescription}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.ClickLinkToSelect}" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0 1 0 0" TextTrimming="CharacterEllipsis">
                            <Run Text="{localization:InspectorLoc Status.CurrentFocusScope}" /><Run Text=" " />
                            <controls:NoFocusHyperlink x:Name="WorkbenchSelectFocusScopeLink"
                                                       Command="{x:Static windows:SnoopUI.SelectFocusScopeCommand}"
                                                       CommandParameter="{Binding CurrentFocusScope}"
                                                       Focusable="False">
                                <Run Text="{Binding CurrentFocusScope, Converter={x:Static converters:ObjectToStringConverter.Instance}, Mode=OneWay}" />
                            </controls:NoFocusHyperlink>
                            <TextBlock.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.FocusScopeDescription}" />
                                    <TextBlock Text="{localization:InspectorLoc Tooltip.ClickLinkToSelect}" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</windows:SnoopMainBaseWindow>
