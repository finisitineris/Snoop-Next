<UserControl x:Class="Snoop.Views.DebugListenerTab.DebugListenerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:attached="clr-namespace:Snoop.AttachedProperties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:Snoop.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Name="checkBoxStartListening"
                      Margin="2 0 4 0"
                      VerticalAlignment="Center"
                      Content="{localization:InspectorLoc DebugListener.StartListening}"
                      FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                      Checked="CheckBoxStartListening_Checked"
                      Unchecked="CheckBoxStartListening_Unchecked" />

            <Label Grid.Column="1"
                   Padding="2 1 4 1"
                   VerticalAlignment="Center"
                   Content="{localization:InspectorLoc DebugListener.TraceLevel}"
                   Target="{Binding ElementName=comboBoxPresentationTraceLevel}" />
            <ComboBox Name="comboBoxPresentationTraceLevel"
                      Grid.Column="2"
                      FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                      ToolTip="{Binding SelectedItem.Content.Text, RelativeSource={RelativeSource Self}}"
                      SelectedIndex="2"
                      SelectionChanged="ComboBoxPresentationTraceLevel_SelectionChanged">
                <ComboBoxItem Tag="Off">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceOff}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="Critical">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceCritical}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="Error">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceError}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="Warning">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceWarning}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="Information">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceInformation}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="Verbose">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceVerbose}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="ActivityTracing">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceActivityTracing}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="All">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.TraceAll}" />
                </ComboBoxItem>
            </ComboBox>

            <Button Name="buttonClear"
                    Grid.Column="3"
                    Margin="4 0 0 0"
                    Padding="5 1"
                    Content="{localization:InspectorLoc DebugListener.ClearText}"
                    FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                    Click="ButtonClear_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label x:Name="OutputSearchLabel"
                   Padding="2 1 4 1"
                   VerticalAlignment="Center"
                   Content="{localization:InspectorLoc DebugListener.Search}"
                   Target="{Binding ElementName=OutputSearchBox}" />
            <TextBox x:Name="OutputSearchBox"
                     Grid.Column="1"
                     MinWidth="0"
                     Padding="3 1"
                     FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                     TextChanged="HandleOutputSearchTextChanged" />
            <Menu x:Name="OutputFiltersMenu" Padding="0"
                  Grid.Column="2"
                  Margin="4 0 0 0"
                  Background="Transparent"
                  IsMainMenu="False"
                  attached:SnoopAttachedProperties.IsSnoopPart="True">
                <MenuItem Header="{localization:InspectorLoc DebugListener.Filters}">
                    <MenuItem Header="{localization:InspectorLoc DebugListener.EditFilter}"
                              Click="ButtonSetFilters_Click" />
                    <MenuItem Header="{localization:InspectorLoc DebugListener.ClearFilters}"
                              Click="ButtonClearFilters_Click" />
                    <Separator />
                    <MenuItem IsEnabled="False">
                        <MenuItem.Header>
                            <TextBlock Name="textBlockStatus">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="{localization:InspectorLoc DebugListener.FilterOff}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                <Setter Property="Text" Value="{localization:InspectorLoc DebugListener.FilterOn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </Grid>

        <TextBox Name="textBoxDebugContent"
                 Grid.Row="2"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
