<UserControl x:Class="Snoop.Views.DebugListenerTab.DebugListenerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:Snoop.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Name="gridTopRow">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Name="checkBoxStartListening"
                      Margin="10"
                      Checked="CheckBoxStartListening_Checked"
                      Unchecked="CheckBoxStartListening_Unchecked">
                <TextBlock Text="{localization:InspectorLoc DebugListener.StartListening}" />
            </CheckBox>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="{localization:InspectorLoc DebugListener.TraceLevel}" />
                <ComboBox Name="comboBoxPresentationTraceLevel"
                          Width="110"
                          Height="25"
                          SelectedIndex="2"
                          SelectionChanged="ComboBoxPresentationTraceLevel_SelectionChanged">
                    <ComboBoxItem Tag="Off">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceOff}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Critical">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceCritical}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Error">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceError}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Warning">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceWarning}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Information">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceInformation}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Verbose">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceVerbose}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="ActivityTracing">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceActivityTracing}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="All">
                        <TextBlock Text="{localization:InspectorLoc DebugListener.TraceAll}" />
                    </ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="10 0 10 10"
                        Orientation="Horizontal">
                <Button Name="buttonClear"
                        Width="75"
                        Height="25"
                        HorizontalAlignment="Left"
                        Click="ButtonClear_Click">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.ClearText}" />
                </Button>
                <Button Name="buttonClearFilters"
                        Width="75"
                        Height="25"
                        Margin="10 0 0 0"
                        HorizontalAlignment="Left"
                        Click="ButtonClearFilters_Click">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.ClearFilters}" />
                </Button>
                <Button Name="buttonSetFilters"
                        Width="75"
                        Height="25"
                        Margin="10 0 0 0"
                        HorizontalAlignment="Left"
                        Click="ButtonSetFilters_Click">
                    <TextBlock Text="{localization:InspectorLoc DebugListener.EditFilter}" />
                </Button>
                <TextBlock Name="textBlockStatus"
                           Margin="10 0 0 0">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="{localization:InspectorLoc DebugListener.FilterOff}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSet}" Value="True">
                                    <Setter Property="Text" Value="{localization:InspectorLoc DebugListener.FilterOn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        </Grid>
        <TextBox Name="textBoxDebugContent"
                 Grid.Row="1"
                 Margin="10"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" />
    </Grid>
</UserControl>
