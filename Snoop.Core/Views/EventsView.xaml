<Grid x:Class="Snoop.Views.EventsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Snoop.Controls"
      xmlns:converters="clr-namespace:Snoop.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006"
      xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
      xmlns:localization="clr-namespace:Snoop.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:snoop="clr-namespace:Snoop"
      xmlns:views="clr-namespace:Snoop.Views"
      x:Name="Events"
      MinWidth="0"
      MinHeight="0"
      SizeChanged="HandleDockSizeChanged"
      mc:Ignorable="d">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="CategoryTemplate">
                <TextBlock Margin="2 5 0 0"
                           FontWeight="Bold"
                           Text="{Binding Path=Name}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type RoutedEventArgs}">
                <TextBlock Text="{Binding RoutedEvent.Name}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type ExecutedRoutedEventArgs}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Command, Converter={x:Static converters:ObjectToStringConverter.Instance}}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type infrastructure:EventTracker}">
                <CheckBox Style="{StaticResource SnoopNext.ChecklistItem}" IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                    <TextBlock Text="{Binding RoutedEvent.Name}" />
                </CheckBox>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type infrastructure:TrackedEvent}"
                                      ItemsSource="{Binding Stack}">
                <StackPanel Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EventArgsText}" />
                        <TextBlock Text="{localization:InspectorLoc Events.On}" />
                        <TextBlock Text="{Binding Originator.Handler, Converter={x:Static converters:ObjectToStringConverter.Instance}}" />
                    </StackPanel>
                    <StackPanel x:Name="Handler" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="{localization:InspectorLoc Events.HandledBy}" />
                        <TextBlock Text="{Binding HandledBy, Converter={x:Static converters:ObjectToStringConverter.Instance}}" />
                    </StackPanel>
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Handled}" Value="True">
                        <Setter TargetName="Handler" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type infrastructure:EventEntry}">
                <Grid Name="Grid"
                      Background="Transparent">
                    <Grid.ToolTip>
                        <TextBlock Text="{localization:InspectorLoc Events.SelectHandlerTip}" />
                    </Grid.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Handler, Converter={x:Static converters:ObjectToStringConverter.Instance}}" />
                        <TextBlock Text="{localization:InspectorLoc Events.Handled}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Handled}" />
                    </StackPanel>
                </Grid>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:NoSelectionComboBox x:Name="EventChooser"
                                  Header="{localization:InspectorLoc Events.ChooseTracked}"
                                  Margin="0 0 20 0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  infrastructure:ComboBoxSettings.RegisterAsSnoopPart="True"
                                  GroupHeaderTemplate="{StaticResource CategoryTemplate}"
                                  IsSynchronizedWithCurrentItem="True"
                                  ItemsSource="{Binding ElementName=Events, Path=AvailableEvents}"
                                  ResetSettingsCommand="{x:Static views:EventsView.ResetEventTrackersToDefaultCommand}"
                                  ResetSettingsToolTip="{localization:InspectorLoc Events.ResetTrackedTip}">
        <ComboBox.ToolTip>
            <TextBlock Text="{localization:InspectorLoc Events.ChooseTrackedTip}" />
        </ComboBox.ToolTip>
    </controls:NoSelectionComboBox>

    <Button Grid.Row="0"
            Width="18"
            Height="18"
            Padding="3"
            HorizontalAlignment="Right"
            AutomationProperties.Name="{localization:InspectorLoc Events.ClearTip}"
            FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
            Command="{x:Static views:EventsView.ClearCommand}">
        <Grid>
            <Path Data="M18.33996,8.7972167 L1.8622991,25.274878"
                  Stretch="Fill"
                  Stroke="{DynamicResource Snoop.Brushes.Default.Foreground}"
                  StrokeThickness="2" />
            <Path Data="M19.831014,18.751491 L4.5959764,3.5164535"
                  Stretch="Fill"
                  Stroke="{DynamicResource Snoop.Brushes.Default.Foreground}"
                  StrokeThickness="2" />
        </Grid>
        <Button.ToolTip>
            <TextBlock Text="{localization:InspectorLoc Events.ClearTip}" />
        </Button.ToolTip>
    </Button>

    <Grid x:Name="FilterRow" Grid.Row="1" Margin="0 2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label x:Name="EventFilterLabel"
               MinHeight="0"
               Padding="2 2 6 2"
               VerticalAlignment="Center"
               Content="{localization:InspectorLoc Events.Filter}"
               Target="{Binding ElementName=EventFilter}" />
        <TextBox x:Name="EventFilter"
                 Grid.Column="1"
                 MinWidth="0"
                 MinHeight="0"
                 Padding="4 2"
                 FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                 ToolTip="{localization:InspectorLoc Events.FilterTip}"
                 TextChanged="HandleEventFilterTextChanged" />
        <StackPanel Grid.Column="2" Margin="6 0 0 0" Orientation="Horizontal">
            <Label x:Name="MaxEventsLabel" MinHeight="0" Padding="0 2 4 2"
                   VerticalAlignment="Center"
                   Content="{localization:InspectorLoc Events.MaximumDisplayed}"
                   Target="{Binding ElementName=MaxEventsEditor}" />
            <TextBox x:Name="MaxEventsEditor"
                     Width="46"
                     MinHeight="0"
                     Padding="4 2"
                     FocusVisualStyle="{DynamicResource SnoopNext.WorkbenchFocusVisual}"
                     Text="{Binding ElementName=Events, Path=MaxEventsDisplayed}" />
        </StackPanel>
    </Grid>

    <TreeView x:Name="EventTree"
              Grid.Row="2"
              HorizontalContentAlignment="Stretch"
              ItemsSource="{Binding ElementName=Events, Path=DisplayedEvents}"
              SelectedItemChanged="EventTree_SelectedItemChanged">
        <TreeView.ItemContainerStyle>
            <Style TargetType="{x:Type TreeViewItem}"
                   BasedOn="{StaticResource ProperTreeViewItemStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Handled}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Snoop.Brushes.EventsView.Handled.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource Snoop.Brushes.EventsView.Handled.Foreground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TreeView.ItemContainerStyle>
    </TreeView>

</Grid>
