<Grid x:Class="Snoop.Controls.PropertyInspector"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Snoop.Controls"
      xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
      xmlns:localization="clr-namespace:Snoop.Localization"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:snoopwpf="clr-namespace:Snoop.Converters"
      x:Name="propertyInspector"
      MinWidth="0"
      MinHeight="0">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <system:Double x:Key="FilterControlHeight">32</system:Double>
            <DataTemplate x:Key="stylelessTextBlockDataTemplate"
                          DataType="infrastructure:PropertyFilterSet">
                <TextBlock Margin="0"
                           Padding="0"
                           TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
            </DataTemplate>
        </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBox x:Name="DelvePathBox" Grid.Row="0"
             Margin="4 4 4 1" Padding="0"
             AcceptsReturn="False"
             Background="Transparent"
             BorderThickness="0"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="True"
             Text="{Binding ElementName=propertyInspector, Path=DelvePath, Mode=OneWay}"
             TextWrapping="Wrap">
        <TextBox.ToolTip>
            <TextBlock Text="{localization:InspectorLoc PropertyInspector.DelvePathTip}" />
        </TextBox.ToolTip>
    </TextBox>

    <TextBlock x:Name="DelveTypeLabel" Grid.Row="1"
               Margin="4 0 4 2"
               Background="Transparent"
               TextWrapping="Wrap">
        <Hyperlink Command="{x:Static controls:PropertyInspector.NavigateToAssemblyInExplorerCommand}"
                   CommandParameter="{Binding ElementName=propertyInspector, Path=DelveType, Mode=OneWay}">
            <Run Text="{Binding ElementName=propertyInspector, Path=DelveType.FullName, Mode=OneWay}" />
        </Hyperlink>

        <TextBlock.ToolTip>
            <TextBlock Text="{localization:InspectorLoc PropertyInspector.DelveTypeTip}" />
        </TextBlock.ToolTip>

        <TextBlock.ContextMenu>
            <ContextMenu x:Name="delveTypeContextMenu">
                <MenuItem Header="{localization:InspectorLoc PropertyInspector.OpenInExplorer}"
                          Command="{x:Static controls:PropertyInspector.NavigateToAssemblyInExplorerCommand}"
                          CommandParameter="{Binding Path=DelveType, Mode=OneWay}"
                          CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                <MenuItem Header="{localization:InspectorLoc PropertyInspector.OpenInILSpy}"
                          Command="{x:Static controls:PropertyInspector.OpenTypeInILSpyCommand}"
                          CommandParameter="{Binding Path=DelveType, Mode=OneWay}"
                          CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                <Separator />
                <MenuItem Header="{localization:InspectorLoc PropertyInspector.CopyFullName}"
                          Command="{x:Static controls:PropertyInspector.CopyFQNameCommand}"
                          CommandParameter="{Binding Path=DelveType, Mode=OneWay}"
                          CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
            </ContextMenu>
        </TextBlock.ContextMenu>
    </TextBlock>

    <Grid x:Name="PropertyFilterToolbar" Grid.Row="2" Margin="4 3 4 6" UseLayoutRounding="True"
          TextElement.FontSize="13" SizeChanged="PropertyFilterToolbar_OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="FilterSearchRow" Grid.ColumnSpan="2" Height="{StaticResource FilterControlHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PropertiesFilter" Padding="8 0" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.FilterPlaceholder}"
                     ToolTip="{localization:InspectorLoc PropertyInspector.FilterTip}"
                     Text="{Binding ElementName=propertyInspector, Path=FilterString, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource SnoopNext.Brush.Border}" Background="{DynamicResource SnoopNext.Brush.Control}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                                <TextBlock x:Name="Hint" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Text="{localization:InspectorLoc PropertyInspector.FilterPlaceholder}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <Image x:Name="FilterError" Grid.Column="1" Margin="4 0 0 0" Width="16"
                   Height="16"
                   Stretch="Uniform"
                   ToolTip="{Binding Path=PropertyFilter.Error, ElementName=propertyInspector}"
                   Visibility="{Binding Path=PropertyFilter.HasError, ElementName=propertyInspector, Converter={x:Static snoopwpf:BoolToVisibilityConverter.DefaultInstance}}">
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V426,667 H426,667 V0 H0 Z">
                                <DrawingGroup.Children>
                                    <GeometryDrawing Brush="Red"
                                                     Geometry="F1 M426.667,426.667z M0,0z M213.333,0C95.514,0 0,95.514 0,213.333 0,331.152 95.514,426.666 213.333,426.666 331.152,426.666 426.666,331.152 426.666,213.333 426.666,95.514 331.153,0 213.333,0z M330.995,276.689L276.693,330.995 213.333,267.639 149.973,330.999 95.671,276.689 159.027,213.333 95.671,149.973 149.973,95.671 213.333,159.027 276.693,95.671 330.995,149.973 267.639,213.333 330.995,276.689z" />
                                </DrawingGroup.Children>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
            <ToggleButton x:Name="RegexToggle" Grid.Column="2" Width="{StaticResource FilterControlHeight}"
                          Margin="4 0 0 0" Padding="0" Content=".*" FontFamily="Consolas, Global Monospace" FontWeight="SemiBold"
                          AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.UseRegexTip}"
                          IsChecked="{Binding Path=UseRegex, ElementName=propertyInspector, Mode=TwoWay}"
                          ToolTip="{localization:InspectorLoc PropertyInspector.UseRegexTip}" />
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="{StaticResource FilterControlHeight}" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterSetCombo" MinWidth="0" MinHeight="0" Padding="8 0 0 0"
                      infrastructure:ComboBoxSettings.RegisterAsSnoopPart="True"
                      AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.FilterSetTip}"
                      ToolTip="{localization:InspectorLoc PropertyInspector.FilterSetTip}"
                      ItemTemplate="{StaticResource stylelessTextBlockDataTemplate}"
                      ItemsSource="{Binding Path=AllFilterSets, ElementName=propertyInspector}"
                      SelectedItem="{Binding Path=SelectedFilterSet, ElementName=propertyInspector, Mode=TwoWay}" />
            <ToggleButton x:Name="defaultsToggle" Grid.Column="1" Margin="4 0 0 0" MinWidth="36" Padding="8 0"
                          IsChecked="{Binding ElementName=propertyInspector, Path=ShowDefaults}"
                          AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.ShowDefaultsTip}"
                          ToolTip="{localization:InspectorLoc PropertyInspector.ShowDefaultsTip}">
                <TextBlock Text="{localization:InspectorLoc PropertyInspector.ShowDefaultsBadge}" />
            </ToggleButton>
            <ToggleButton x:Name="uncommonToggle" Grid.Column="2" Margin="4 0 0 0" MinWidth="36" Padding="8 0"
                          IsChecked="{Binding ElementName=propertyInspector, Path=ShowUncommonProperties}"
                          AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.ShowUncommonTip}"
                          ToolTip="{localization:InspectorLoc PropertyInspector.ShowUncommonTip}">
                <TextBlock Text="{localization:InspectorLoc PropertyInspector.ShowUncommonBadge}" />
            </ToggleButton>
        </Grid>
        <StackPanel x:Name="DelveOptions" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Height="{StaticResource FilterControlHeight}" Margin="0 4 0 0">
            <CheckBox x:Name="checkBoxClearAfterDelve" VerticalContentAlignment="Center"
                      Content="{localization:InspectorLoc PropertyInspector.ClearAfterDelve}" />
            <Button x:Name="PopTargetButton" Width="{StaticResource FilterControlHeight}" Padding="0" Margin="4 0 0 0"
                    Command="{x:Static controls:PropertyInspector.PopTargetCommand}"
                    AutomationProperties.Name="{localization:InspectorLoc PropertyInspector.PopTargetTip}"
                    ToolTip="{localization:InspectorLoc PropertyInspector.PopTargetTip}" ToolTipService.ShowOnDisabled="True">
                <Path Width="12" Height="12" Data="M1,7 L6,2 L11,7 M6,2 V11" StrokeThickness="1.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
        </StackPanel>
    </Grid>

    <controls:PropertyGrid2 x:Name="PropertyGrid"
                            Grid.Row="3"
                            Grid.Column="1"
                            MinWidth="0"
                            MinHeight="0"
                            Target="{Binding ElementName=propertyInspector, Path=Target}" />
</Grid>
