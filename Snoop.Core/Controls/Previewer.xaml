<UserControl x:Class="Snoop.Controls.Previewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Snoop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:Snoop.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="options d">
    <UserControl.Resources>
        <ResourceDictionary>
            <DrawingBrush x:Key="previewerSnoopDogDrawingBrush"
                          Stretch="Uniform"
                          options:Freeze="True">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <DrawingGroup.Children>
                            <GeometryDrawing Brush="#FFE8E8E8"
                                             Geometry="{DynamicResource snoopDogStreamGeometry}" />
                        </DrawingGroup.Children>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style x:Key="PreviewGlyph" TargetType="{x:Type Path}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
        <controls:ZoomerControl x:Name="Zoomer">
            <controls:ZoomerControl.Style>
                <Style TargetType="{x:Type controls:ZoomerControl}">
                    <Style.Triggers>
                        <!-- The previewer supplies this brush as its idle or paused artwork. -->
                        <DataTrigger Binding="{Binding Target, RelativeSource={RelativeSource Self}}"
                                     Value="{StaticResource previewerSnoopDogDrawingBrush}">
                            <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ZoomerControl.Style>
        </controls:ZoomerControl>

        <Button Width="28"
                Height="28"
                Margin="0 0 68 4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{localization:InspectorLoc Previewer.MagnifyTip}"
                Command="{x:Static controls:Previewer.MagnifyCommand}">
            <Path Style="{StaticResource PreviewGlyph}" Data="M10,6 A4,4 0 1 1 2,6 A4,4 0 1 1 10,6 M9,9 L14,14" />
            <Button.ToolTip>
                <TextBlock MaxWidth="260"
                           Text="{localization:InspectorLoc Previewer.MagnifyTip}"
                           TextWrapping="Wrap" />
            </Button.ToolTip>
        </Button>

        <ToggleButton Width="28"
                      Height="28"
                      Margin="0 0 36 4"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      AutomationProperties.Name="{localization:InspectorLoc Previewer.ToggleTip}"
                      IsChecked="{Binding IsActive}">
            <Path Style="{StaticResource PreviewGlyph}" Data="M8,1 V7 M4.5,3.5 A6,6 0 1 0 11.5,3.5" />
            <ToggleButton.ToolTip>
                <TextBlock MaxWidth="260"
                           Text="{localization:InspectorLoc Previewer.ToggleTip}"
                           TextWrapping="Wrap" />
            </ToggleButton.ToolTip>
        </ToggleButton>

        <Button Width="28"
                Height="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0 0 4 4"
                AutomationProperties.Name="{localization:InspectorLoc Previewer.ScreenshotTip}"
                Command="{x:Static controls:Previewer.ScreenshotCommand}">
            <Path Style="{StaticResource PreviewGlyph}" Data="M1,5 H4 L6,2.5 H10 L12,5 H15 V13 H1 Z M11,8.5 A3,3 0 1 1 5,8.5 A3,3 0 1 1 11,8.5" />
            <Button.ToolTip>
                <TextBlock Text="{localization:InspectorLoc Previewer.ScreenshotTip}" />
            </Button.ToolTip>
        </Button>
    </Grid>
</UserControl>
