<UserControl x:Class="Snoop.Controls.ZoomerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Viewport"
             xmlns:windows="clr-namespace:Snoop.Windows"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Focusable="True"
             mc:Ignorable="d">
    <Grid x:Name="DocumentRoot"
          ClipToBounds="True"
          FocusVisualStyle="{x:Null}"
          Focusable="True"
          LostMouseCapture="Content_LostMouseCapture"
          Mouse.MouseDown="Content_MouseDown"
          Mouse.MouseMove="Content_MouseMove"
          Mouse.MouseUp="Content_MouseUp">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{Binding Background, ElementName=Viewport}" />
                <Style.Triggers>
                    <!-- A real preview keeps its user-adjustable inspection backdrop. -->
                    <DataTrigger Binding="{Binding Background, ElementName=Viewport}" Value="{x:Null}">
                        <Setter Property="Background"
                                Value="{Binding BackdropBrightness, ElementName=Viewport, Converter={x:Static windows:DoubleToWhitenessConverter.Default}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Target, ElementName=Viewport}" Value="{x:Null}">
                        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Viewbox x:Name="Viewbox" />

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="PreviewSelectionOutline"
                       Stroke="{DynamicResource SnoopNext.Brush.Accent}"
                       StrokeThickness="2"
                       SnapsToDevicePixels="True"
                       Visibility="Collapsed" />
        </Canvas>

    </Grid>
</UserControl>
