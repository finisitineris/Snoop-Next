<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infrastructure="clr-namespace:Snoop.Infrastructure">
    <Style TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SnoopNext.FocusVisual}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckSurface" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="CheckBoxBorder" Width="16" Height="16" VerticalAlignment="Center"
                                    DockPanel.Dock="Left" CornerRadius="3" BorderThickness="1"
                                    Background="{DynamicResource SnoopNext.Brush.Control}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Path x:Name="CheckGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M1,5 L4,8 10,1.5" Stroke="{DynamicResource SnoopNext.Brush.OnAccent}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Hidden" />
                            </Border>
                            <ContentPresenter x:Name="CheckLabel" Margin="7,0,0,0" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="CheckLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="CheckGlyph" Property="Data" Value="M1,5 H9" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                            <Setter TargetName="CheckGlyph" Property="Stroke" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SnoopNext.ChecklistItem" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SnoopNext.ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The inspector's property editors and diagnostics use GridView columns with their own sort command. -->
    <Style x:Key="GridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Path x:Name="SortMark" DockPanel.Dock="Right" Width="9" Margin="3,0,0,0" VerticalAlignment="Center"
                                      Data="M1,5 L4.5,1.5 8,5" Stroke="{DynamicResource SnoopNext.Brush.Accent}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Visibility="Collapsed" />
                                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="HeaderDivider" Width="1" Margin="0,6,0,6" HorizontalAlignment="Right"
                                Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Style="{StaticResource SnoopNext.ColumnGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="infrastructure:GridViewSort.Direction" Value="Ascending">
                            <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="infrastructure:GridViewSort.Direction" Value="Descending">
                            <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortMark" Property="Data" Value="M1,1.5 L4.5,5 8,1.5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
                            <Setter TargetName="HeaderDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="Floating">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Canvas x:Name="PART_FloatingHeaderCanvas" Opacity="0.8" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderStyle}" />

    <Style x:Key="GridView.GridViewStyle" TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border x:Name="TableSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer Style="{DynamicResource GridView.GridViewScrollViewerStyle}" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="True" />
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GridView.GridViewItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SnoopNext.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <!-- Keep property-source/animation warning colors visible beneath interaction feedback. -->
                        <Border x:Name="RowState" CornerRadius="3" Background="Transparent" IsHitTestVisible="False" />
                        <GridViewRowPresenter Margin="2,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="SelectionRail" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Height="14" Width="3" CornerRadius="1.5" Background="{DynamicResource SnoopNext.Brush.Accent}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowState" Property="Background" Value="{DynamicResource SnoopNext.Brush.Text}" />
                            <Setter TargetName="RowState" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowState" Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="RowState" Property="Opacity" Value="0.12" />
                            <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keep the native DataGrid presenters, header grippers, sorting, edit controls and scrolling. -->
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource SnoopNext.Brush.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SnoopNext.Brush.Control}" />
        <Setter Property="MinRowHeight" Value="28" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid SnapsToDevicePixels="True">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <DockPanel>
                                            <Path x:Name="SortMark" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                  VerticalAlignment="Center" Data="M1,5 L4.5,1.5 8,5" Visibility="Collapsed"
                                                  Stroke="{DynamicResource SnoopNext.Brush.Accent}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </DockPanel>
                                    </Border>
                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource SnoopNext.ColumnGripper}" />
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource SnoopNext.ColumnGripper}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="SortMark" Property="Data" Value="M1,1.5 L4.5,5 8,1.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
