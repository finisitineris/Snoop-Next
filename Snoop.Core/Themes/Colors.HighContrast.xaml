<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dynamic system resources also follow edits to a custom contrast theme. -->
    <SolidColorBrush x:Key="SnoopNext.Brush.Text" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.TextSecondary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Panel" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Background" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Control" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Border" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Hover" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Pressed" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.OnAccent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Error" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <StaticResource x:Key="Snoop.Brushes.Default.Background" ResourceKey="SnoopNext.Brush.Panel" />
    <StaticResource x:Key="Snoop.Brushes.Default.Foreground" ResourceKey="SnoopNext.Brush.Text" />
    <StaticResource x:Key="Menu.Static.Foreground" ResourceKey="SnoopNext.Brush.Text" />
    <StaticResource x:Key="ComboBox.Static.Glyph" ResourceKey="SnoopNext.Brush.Text" />
    <StaticResource x:Key="ComboBox.MouseOver.Glyph" ResourceKey="SnoopNext.Brush.Text" />
    <StaticResource x:Key="ComboBox.Pressed.Glyph" ResourceKey="SnoopNext.Brush.Text" />
    <StaticResource x:Key="Snoop.Brushes.Default.GrayForeground" ResourceKey="SnoopNext.Brush.TextSecondary" />
    <StaticResource x:Key="Snoop.Brushes.GridViewColumnHeader.SortIndicator" ResourceKey="SnoopNext.Brush.TextSecondary" />
    <StaticResource x:Key="GridViewColumnHeaderBackground" ResourceKey="SnoopNext.Brush.Control" />
    <StaticResource x:Key="ComboBox.Static.Background" ResourceKey="SnoopNext.Brush.Control" />
    <StaticResource x:Key="TabItem.Static.Background" ResourceKey="SnoopNext.Brush.Control" />
    <StaticResource x:Key="Menu.Static.Background" ResourceKey="SnoopNext.Brush.Panel" />
    <StaticResource x:Key="TabItem.Selected.Background" ResourceKey="SnoopNext.Brush.Panel" />
    <StaticResource x:Key="ComboBox.Static.Editable.Background" ResourceKey="SnoopNext.Brush.Panel" />
    <StaticResource x:Key="GridViewColumnHeaderBorderBackground" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="ComboBox.Static.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="ComboBox.Static.Editable.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="Snoop.Brushes.Default.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="TabItem.Selected.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="TabItem.Static.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="Menu.Static.Border" ResourceKey="SnoopNext.Brush.Border" />
    <StaticResource x:Key="GridViewColumnHeaderHoverBackground" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="ComboBox.MouseOver.Background" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="ComboBox.MouseOver.Editable.Button.Background" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="MenuItem.Highlight.Background" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="MenuItem.Selected.Background" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="TabItem.MouseOver.Background" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="ListItemHoverFill" ResourceKey="SnoopNext.Brush.Hover" />
    <StaticResource x:Key="GridViewColumnHeaderPressBackground" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="ComboBox.Pressed.Background" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="ComboBox.Pressed.Editable.Button.Background" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="ListItemSelectedFill" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="ListItemSelectedHoverFill" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="ListItemSelectedInactiveFill" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="Snoop.Brushes.Default.InactiveSelectionHighlight" ResourceKey="SnoopNext.Brush.Pressed" />
    <StaticResource x:Key="Snoop.Brushes.Default.Highlight" ResourceKey="SnoopNext.Brush.Accent" />
    <StaticResource x:Key="Snoop.Brushes.Default.HotTrack" ResourceKey="SnoopNext.Brush.Accent" />
    <StaticResource x:Key="TextBox.Focus.Border" ResourceKey="SnoopNext.Brush.Accent" />
    <StaticResource x:Key="Snoop.Brushes.Default.HighlightForeground" ResourceKey="SnoopNext.Brush.OnAccent" />
</ResourceDictionary>
