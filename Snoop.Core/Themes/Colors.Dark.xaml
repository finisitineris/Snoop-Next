<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Color x:Key="SnoopNext.Color.Text">#FFFFFF</Color>
    <Color x:Key="SnoopNext.Color.TextSecondary">#C8C8C8</Color>
    <Color x:Key="SnoopNext.Color.Panel">#2C2C2C</Color>
    <Color x:Key="SnoopNext.Color.Background">#202020</Color>
    <Color x:Key="SnoopNext.Color.Control">#373737</Color>
    <Color x:Key="SnoopNext.Color.Border">#505050</Color>
    <Color x:Key="SnoopNext.Color.Hover">#414141</Color>
    <Color x:Key="SnoopNext.Color.Pressed">#343434</Color>
    <Color x:Key="SnoopNext.Color.Accent">#60CDFF</Color>
    <Color x:Key="SnoopNext.Color.OnAccent">#00354A</Color>
    <Color x:Key="SnoopNext.Color.Error">#FF99A4</Color>

    <SolidColorBrush x:Key="SnoopNext.Brush.Text" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.TextSecondary" Color="{StaticResource SnoopNext.Color.TextSecondary}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Panel" Color="{StaticResource SnoopNext.Color.Panel}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Background" Color="{StaticResource SnoopNext.Color.Background}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Control" Color="{StaticResource SnoopNext.Color.Control}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Hover" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Pressed" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Accent" Color="{StaticResource SnoopNext.Color.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.OnAccent" Color="{StaticResource SnoopNext.Color.OnAccent}" options:Freeze="True" />
    <SolidColorBrush x:Key="SnoopNext.Brush.Error" Color="{StaticResource SnoopNext.Color.Error}" options:Freeze="True" />

    <SolidColorBrush x:Key="Snoop.Brushes.Default.Background" Color="#2E2E2E" options:Freeze="True" />
    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="{StaticResource SnoopNext.Color.Panel}" options:Freeze="True" />

    <SolidColorBrush x:Key="GridViewColumnHeaderHoverBackground" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />

    <SolidColorBrush x:Key="Snoop.Brushes.EventsView.Handled.Background" Color="LightGreen" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.EventsView.Handled.Foreground" Color="Black" options:Freeze="True" />

    <SolidColorBrush x:Key="Snoop.Brushes.Default.Foreground" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="{StaticResource SnoopNext.Color.Text}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.GrayForeground" Color="{StaticResource SnoopNext.Color.TextSecondary}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.GridViewColumnHeader.SortIndicator" Color="{StaticResource SnoopNext.Color.TextSecondary}" options:Freeze="True" />
    <SolidColorBrush x:Key="GridViewColumnHeaderBackground" Color="{StaticResource SnoopNext.Color.Control}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="{StaticResource SnoopNext.Color.Control}" options:Freeze="True" />
    <SolidColorBrush x:Key="TabItem.Static.Background" Color="{StaticResource SnoopNext.Color.Control}" options:Freeze="True" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="{StaticResource SnoopNext.Color.Panel}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="{StaticResource SnoopNext.Color.Panel}" options:Freeze="True" />
    <SolidColorBrush x:Key="GridViewColumnHeaderBorderBackground" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="{StaticResource SnoopNext.Color.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="ListItemHoverFill" Color="{StaticResource SnoopNext.Color.Hover}" options:Freeze="True" />
    <SolidColorBrush x:Key="GridViewColumnHeaderPressBackground" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Background" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="ListItemSelectedFill" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="ListItemSelectedHoverFill" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="ListItemSelectedInactiveFill" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.InactiveSelectionHighlight" Color="{StaticResource SnoopNext.Color.Pressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.Highlight" Color="{StaticResource SnoopNext.Color.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.HotTrack" Color="{StaticResource SnoopNext.Color.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="{StaticResource SnoopNext.Color.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.Default.HighlightForeground" Color="{StaticResource SnoopNext.Color.OnAccent}" options:Freeze="True" />

    <SolidColorBrush x:Key="Snoop.Brushes.ItemsControl.AlternationBackground" Color="#292B2D" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.IsLocallySetForeground" Color="#80C9FA" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.HasChangedRecently" Color="#4C3D17" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.IsExpression" Color="#193B2B" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.IsAnimated" Color="#493023" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.InvalidBindingBackground" Color="#482326" options:Freeze="True" />
    <SolidColorBrush x:Key="Snoop.Brushes.PropertyGrid.InvalidBindingForeground" Color="#FFB3B5" options:Freeze="True" />
</ResourceDictionary>
