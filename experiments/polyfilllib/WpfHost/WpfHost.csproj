<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net6.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <SuppressTfmSupportBuildWarnings>false</SuppressTfmSupportBuildWarnings>
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net462'">x86</PlatformTarget>
    <AppConfig Condition="'$(TargetFramework)' == 'net462'">$(MSBuildProjectDirectory)/net462.config</AppConfig>
    <OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PolyfillLib" Version="11.4.5" />
  </ItemGroup>
</Project>
