<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
                    xmlns:converters="clr-namespace:Snoop.Converters"
                    xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
                    xmlns:snoop="clr-namespace:Snoop"
                    xmlns:snoopwpf="urn:snoopwpf">
    <Style x:Key="LauncherFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" BorderBrush="{DynamicResource SnoopNext.Brush.Text}"
                            BorderThickness="2" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LauncherButton" TargetType="Button">
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LauncherFocus}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LauncherPrimaryButton" TargetType="Button" BasedOn="{StaticResource LauncherButton}">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Control}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LauncherIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <Style x:Key="LauncherDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Border}" />
    </Style>

    <Style x:Key="LauncherTargetRow" TargetType="ComboBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding OwningProcessId, StringFormat='TargetProcess.{0}', ConverterCulture=en-US}" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="SelectionMark" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource SnoopNext.Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                            <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Row" Property="Padding" Value="7,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="LauncherSelectedTarget">
        <DockPanel ClipToBounds="True">
            <Image Width="14" Height="14" Margin="0,0,4,0"
                   Visibility="{Binding OwningProcessInfo.IsProcessElevated, Converter={x:Static snoopwpf:BoolToVisibilityConverter.DefaultInstance}}"
                   Source="{Binding Source={x:Static infrastructure:SystemIcon.Shield}, Converter={x:Static converters:SystemIconToImageSourceConverter.Instance}, ConverterParameter=16}" />
            <TextBlock TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} [{1}] — {2}">
                        <Binding Path="ProcessName" />
                        <Binding Path="OwningProcessId" />
                        <Binding Path="WindowTitle" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>
    </DataTemplate>

    <Style x:Key="LauncherTargetList" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LauncherFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding TargetFilterText}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherTargetRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsTabStop="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Field" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource SnoopNext.Brush.Control}"
                                            BorderBrush="{DynamicResource SnoopNext.Brush.Border}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selection" Margin="10,0,25,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectedItem}"
                                          ContentTemplate="{StaticResource LauncherSelectedTarget}" />
                        <TextBlock x:Name="Placeholder" Margin="10,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="{local:Loc Chooser.SelectTarget}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                   Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}" />
                        <Path x:Name="FilterMark" Visibility="Collapsed" Width="11" Height="11" Margin="0,0,26,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Stretch="Uniform"
                              Stroke="{DynamicResource SnoopNext.Brush.Accent}" StrokeThickness="1.4"
                              Data="M1,2 H13 L8.5,7 V11 L5.5,13 V7 Z" />
                        <Path Width="9" Height="5" Margin="0,0,10,0" Stretch="Fill" HorizontalAlignment="Right"
                              VerticalAlignment="Center" IsHitTestVisible="False" StrokeThickness="1.25"
                              Stroke="{DynamicResource SnoopNext.Brush.Text}" Data="M 0,0 L 4,4 L 8,0" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" VerticalOffset="3" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                                    Background="{DynamicResource SnoopNext.Brush.Panel}">
                                <Grid MinWidth="218">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="2,1,2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TargetSearchBox" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                                                 Foreground="{DynamicResource SnoopNext.Brush.Text}" Background="{DynamicResource SnoopNext.Brush.Control}"
                                                 BorderBrush="{DynamicResource SnoopNext.Brush.Border}" BorderThickness="1"
                                                 Text="{Binding DataContext.TargetSearch, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{local:Loc Chooser.SearchTargets}" ToolTip="{local:Loc Chooser.SearchTargets}" />
                                        <TextBlock x:Name="SearchHint" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                                   Visibility="Collapsed" Text="{local:Loc Chooser.SearchTargets}" />
                                        <Button x:Name="ClearTargetSearchButton" Grid.Column="1" Margin="2,0,0,0" Style="{StaticResource LauncherButton}"
                                                Command="{x:Static snoop:AppChooser.ClearTargetFiltersCommand}"
                                                CommandTarget="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                                AutomationProperties.Name="{local:Loc Chooser.ClearFilters}" ToolTip="{local:Loc Chooser.ClearFilters}">
                                            <Path Style="{StaticResource LauncherIcon}" Width="11" Height="11" Data="M1,1 L10,10 M10,1 L1,10" />
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="2,0,2,5">
                                        <Grid.Resources>
                                            <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Themes/FluentFlyouts.xaml" />
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Margin="2,0,0,2" Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}"
                                                       Text="{local:Loc Chooser.Runtime}" />
                                            <ComboBox x:Name="TargetRuntimeFilter" Height="30" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding DataContext.TargetRuntimeFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      AutomationProperties.Name="{local:Loc Chooser.Runtime}">
                                                <ComboBoxItem Tag="{x:Static snoop:TargetRuntime.None}" Content="{local:Loc Chooser.All}" />
                                                <ComboBoxItem Tag="{x:Static snoop:TargetRuntime.NetFramework}" Content=".NET Framework" />
                                                <ComboBoxItem Tag="{x:Static snoop:TargetRuntime.CoreClr}" Content=".NET (CoreCLR)" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Margin="2,0,0,2" Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}"
                                                       Text="{local:Loc Chooser.Architecture}" />
                                            <ComboBox x:Name="TargetArchitectureFilter" Height="30" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding DataContext.TargetArchitectureFilter, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      AutomationProperties.Name="{local:Loc Chooser.Architecture}">
                                                <ComboBoxItem Tag="" Content="{local:Loc Chooser.All}" />
                                                <ComboBoxItem Tag="x86" Content="x86" />
                                                <ComboBoxItem Tag="x64" Content="x64" />
                                                <ComboBoxItem Tag="ARM" Content="ARM" />
                                                <ComboBoxItem Tag="ARM64" Content="ARM64" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="2" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" Grid.IsSharedSizeScope="True"
                                                        Tag="{Binding DataContext.SortColumn, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="EmptyList" Grid.Row="2" Margin="8,6" Visibility="Collapsed"
                                               Foreground="{DynamicResource SnoopNext.Brush.TextSecondary}"
                                               Text="{local:Loc Chooser.Empty}" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="TargetSearchBox" Property="TextBox.Text" Value="">
                            <Setter TargetName="SearchHint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasTargetFilter}" Value="True">
                            <Setter TargetName="FilterMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Margin" Value="10,0,42,0" />
                            <Setter TargetName="Placeholder" Property="Margin" Value="10,0,42,0" />
                            <Setter TargetName="Placeholder" Property="Text" Value="{Binding TargetFilterText}" />
                            <Setter TargetName="EmptyList" Property="Text" Value="{local:Loc Chooser.NoMatches}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasTargetFilter}" Value="True" />
                                <Condition Binding="{Binding TargetFilterText}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Text" Value="{local:Loc Chooser.FiltersActive}" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{local:Loc Chooser.FiltersActive}" />
                        </MultiDataTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="EmptyList" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
