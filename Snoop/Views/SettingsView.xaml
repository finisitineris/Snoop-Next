<UserControl x:Class="Snoop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:snoop="urn:snoopwpf"
             xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
             x:Name="Control"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="Snoop.Styles.Button.Large"
                       TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="MinWidth" Value="100" />
                    <Setter Property="Padding" Value="5" />
                </Style>

            </ResourceDictionary>
        </Grid.Resources>

        <ListView x:Name="ListView"
                  Grid.Row="0"
                  MinWidth="0"
                  MinHeight="0"
                  HorizontalContentAlignment="Stretch"
                  AlternationCount="2"
                  Background="{DynamicResource Snoop.Brushes.Default.Background}"
                  Foreground="{DynamicResource Snoop.Brushes.Default.Foreground}"
                  IsSynchronizedWithCurrentItem="True"
                  ItemsSource="{Binding ElementName=Control, Path=Properties}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}"
                       BasedOn="{StaticResource GridView.GridViewItemContainerStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="24" />
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource Snoop.Brushes.ItemsControl.AlternationBackground}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChangedRecently}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Snoop.Brushes.PropertyGrid.HasChangedRecently}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="200">
                        <GridViewColumn.Header>
                            <TextBlock Text="{local:Loc Property.Name}">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{local:Loc Property.NameDescription}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="snoop:PropertyInformation">
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.ToolTip>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="200"
                                    CellTemplateSelector="{DynamicResource EditorSelector}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{local:Loc Property.Value}" />
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{local:Loc Property.ValueDescription}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Apply language on Save only: selection has no preview side effects.
             Reset changes the pending choice; Discard restores persisted value. -->
        <StackPanel Grid.Row="1"
                    Margin="5,8,5,4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="{local:Loc Settings.Language}"
                       VerticalAlignment="Center"
                       Margin="5,0,12,0" />
            <ComboBox x:Name="LanguageSelector"
                      SelectedValuePath="Tag"
                      Width="188"
                      MinHeight="28"
                      VerticalAlignment="Center">
                <ComboBoxItem Tag="zh-CN" Content="{local:Loc Settings.Chinese}" />
                <ComboBoxItem Tag="en-US" Content="{local:Loc Settings.English}" />
                <ComboBoxItem Tag="system" Content="{local:Loc Settings.FollowSystem}" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
            <Button x:Name="SaveSettingsAndClose"
                    Style="{StaticResource Snoop.Styles.Button.Large}"
                    Click="SaveSettingsAndClose_OnClick">
                <TextBlock Text="{local:Loc Settings.SaveAndClose}" />
            </Button>
            <Button x:Name="DiscardSettings"
                    Style="{StaticResource Snoop.Styles.Button.Large}"
                    Click="DiscardSettings_OnClick">
                <TextBlock Text="{local:Loc Settings.DiscardChanges}" />
            </Button>
            <Button x:Name="ResetAllSettings"
                    Style="{StaticResource Snoop.Styles.Button.Large}"
                    Click="ResetAllSettings_OnClick">
                <TextBlock Text="{local:Loc Settings.ResetAll}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>