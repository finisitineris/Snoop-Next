<UserControl x:Class="Snoop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="clr-namespace:Snoop.Data;assembly=Snoop.Core"
             x:Name="Control"
             Background="{DynamicResource SnoopNext.Brush.Background}"
             FontFamily="{DynamicResource SnoopNext.FontFamily.UI}"
             FontSize="{DynamicResource SnoopNext.FontSize.UI}"
             Foreground="{DynamicResource SnoopNext.Brush.Text}"
             d:DesignHeight="640"
             d:DesignWidth="560"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ComboBox projects the selected item's content template into a second presenter. -->
            <DataTemplate x:Key="SettingsOptionText">
                <TextBlock FontFamily="{DynamicResource SnoopNext.FontFamily.UI}" FontSize="{StaticResource SnoopNext.FontSize.UI}"
                           Foreground="{DynamicResource SnoopNext.Brush.Text}" Text="{Binding}" />
            </DataTemplate>

            <Style x:Key="SettingsOption" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="FontFamily" Value="{DynamicResource SnoopNext.FontFamily.UI}" />
                <Setter Property="FontSize" Value="{StaticResource SnoopNext.FontSize.UI}" />
                <Setter Property="ContentTemplate" Value="{StaticResource SettingsOptionText}" />
            </Style>
            <Style x:Key="SettingsSelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsOption}" />
                <Setter Property="SelectedValuePath" Value="Tag" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource SnoopNext.FocusVisual}" />
            </Style>
            <Style x:Key="SettingsFieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Padding" Value="0,2,10,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource SnoopNext.FocusVisual}" />
            </Style>
            <Style x:Key="SettingsTextInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style x:Key="SettingsHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="Border">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12 4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsPrimaryAction" TargetType="Button" BasedOn="{StaticResource SettingsAction}">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SnoopNext.Brush.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,4">
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{local:Loc Settings.LauncherSection}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="LanguageLabel" Style="{StaticResource SettingsFieldLabel}"
                                   Content="{local:Loc Settings.Language}" Target="{Binding ElementName=LanguageSelector}" />
                            <ComboBox x:Name="LanguageSelector" Grid.Column="1" Style="{StaticResource SettingsSelector}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}">
                                <ComboBoxItem Tag="zh-CN" Content="{local:Loc Settings.Chinese}" />
                                <ComboBoxItem Tag="en-US" Content="{local:Loc Settings.English}" />
                                <ComboBoxItem Tag="system" Content="{local:Loc Settings.FollowSystem}" />
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label x:Name="GlobalHotKeyLabel" Style="{StaticResource SettingsFieldLabel}"
                                       Content="{local:Loc Settings.GlobalHotKey}" Target="{Binding ElementName=GlobalHotKeyEditor}" />
                                <Button x:Name="GlobalHotKeyEditor" Grid.Column="1" HorizontalContentAlignment="Left"
                                        Style="{StaticResource SettingsAction}" AutomationProperties.LabeledBy="{Binding ElementName=GlobalHotKeyLabel}"
                                        AutomationProperties.HelpText="{Binding Text, ElementName=ShortcutHint}"
                                        Click="RecordShortcut_OnClick" GotKeyboardFocus="Recorder_OnGotKeyboardFocus" LostKeyboardFocus="Recorder_OnLostKeyboardFocus"
                                        PreviewKeyDown="Recorder_OnPreviewKeyDown" PreviewKeyUp="Recorder_OnPreviewKeyUp" />
                                <Button x:Name="ResetShortcut" Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource SettingsAction}"
                                        Content="{local:Loc Settings.ShortcutReset}" Click="ResetShortcut_OnClick" />
                                <Button x:Name="DisableShortcut" Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource SettingsAction}"
                                        Content="{local:Loc Settings.ShortcutDisable}" Click="DisableShortcut_OnClick" />
                            </Grid>
                            <TextBlock x:Name="ShortcutHint" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,3"
                                       FontFamily="{DynamicResource SnoopNext.FontFamily.UI}" FontSize="{StaticResource SnoopNext.FontSize.UI}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <CheckBox x:Name="StartAppChooserMinimizedCheckBox" Style="{StaticResource SettingsCheck}"
                                  Content="{local:Loc Settings.StartMinimized}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{local:Loc Settings.InspectorSection}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="MultipleAppDomainModeLabel" Style="{StaticResource SettingsFieldLabel}"
                                   Content="{local:Loc Settings.MultipleAppDomains}" Target="{Binding ElementName=MultipleAppDomainModeSelector}" />
                            <ComboBox x:Name="MultipleAppDomainModeSelector" Grid.Column="1" Style="{StaticResource SettingsSelector}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=MultipleAppDomainModeLabel}">
                                <ComboBoxItem Tag="{x:Static data:MultipleAppDomainMode.Ask}" Content="{local:Loc Settings.ModeAsk}" />
                                <ComboBoxItem Tag="{x:Static data:MultipleAppDomainMode.AlwaysUse}" Content="{local:Loc Settings.ModeAlways}" />
                                <ComboBoxItem Tag="{x:Static data:MultipleAppDomainMode.NeverUse}" Content="{local:Loc Settings.ModeNever}" />
                            </ComboBox>
                            <Label x:Name="MultipleDispatcherModeLabel" Grid.Row="1" Style="{StaticResource SettingsFieldLabel}"
                                   Content="{local:Loc Settings.MultipleDispatchers}" Target="{Binding ElementName=MultipleDispatcherModeSelector}" />
                            <ComboBox x:Name="MultipleDispatcherModeSelector" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsSelector}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=MultipleDispatcherModeLabel}">
                                <ComboBoxItem Tag="{x:Static data:MultipleDispatcherMode.Ask}" Content="{local:Loc Settings.ModeAsk}" />
                                <ComboBoxItem Tag="{x:Static data:MultipleDispatcherMode.AlwaysUse}" Content="{local:Loc Settings.ModeAlways}" />
                                <ComboBoxItem Tag="{x:Static data:MultipleDispatcherMode.NeverUse}" Content="{local:Loc Settings.ModeNever}" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="SetOwnerWindowCheckBox" Style="{StaticResource SettingsCheck}" Content="{local:Loc Settings.SetOwnerWindow}" />
                        <CheckBox x:Name="ShowActivatedCheckBox" Style="{StaticResource SettingsCheck}" Content="{local:Loc Settings.ShowActivated}" />
                        <CheckBox x:Name="EnableDiagnosticsCheckBox" Style="{StaticResource SettingsCheck}" Content="{local:Loc Settings.EnableDiagnostics}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{local:Loc Settings.ToolsSection}" />
                        <Label x:Name="ILSpyPathLabel" Style="{StaticResource SettingsFieldLabel}"
                               Content="{local:Loc Settings.ILSpyPath}" Target="{Binding ElementName=ILSpyPathTextBox}" />
                        <TextBox x:Name="ILSpyPathTextBox" Style="{StaticResource SettingsTextInput}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ILSpyPathLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="SaveError" Grid.Row="1" Margin="16,4" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource SnoopNext.Brush.Error}" Text="{local:Loc Settings.SaveFailed}" />
        <Border Grid.Row="2"
                Background="{DynamicResource SnoopNext.Brush.Panel}"
                BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                BorderThickness="0 1 0 0"
                Padding="16 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetAllSettings"
                        Click="ResetAllSettings_OnClick"
                        Content="{local:Loc Settings.ResetAll}"
                        Style="{StaticResource SettingsAction}" />
                <Button x:Name="DiscardSettings"
                        Grid.Column="2"
                        Margin="8 0"
                        Click="DiscardSettings_OnClick"
                        Content="{local:Loc Settings.DiscardChanges}"
                        Style="{StaticResource SettingsAction}" />
                <Button x:Name="SaveSettingsAndClose"
                        Grid.Column="3"
                        Click="SaveSettingsAndClose_OnClick"
                        Content="{local:Loc Settings.SaveAndClose}"
                        Style="{StaticResource SettingsPrimaryAction}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
