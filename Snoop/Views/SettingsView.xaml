<UserControl x:Class="Snoop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:snoop="urn:snoopwpf"
             x:Name="Control"
             Background="{DynamicResource SnoopNext.Brush.Background}"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource SnoopNext.Brush.Text}"
             d:DesignHeight="440"
             d:DesignWidth="560"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Snoop.Core;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsSection" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12 4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsPrimaryAction" TargetType="Button" BasedOn="{StaticResource SettingsAction}">
                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SnoopNext.Brush.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.OnAccent}" />
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="16 16 16 12" Padding="12 8" Style="{StaticResource SettingsSection}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label x:Name="LanguageLabel"
                       Content="{local:Loc Settings.Language}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SnoopNext.Brush.Text}"
                       Padding="0"
                       Target="{Binding ElementName=LanguageSelector}"
                       VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageSelector"
                          Grid.Column="1"
                          Width="188"
                          MinHeight="32"
                          AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                          FocusVisualStyle="{StaticResource SnoopNext.FocusVisual}"
                          SelectedValuePath="Tag"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Tag="zh-CN" Content="{local:Loc Settings.Chinese}" />
                    <ComboBoxItem Tag="en-US" Content="{local:Loc Settings.English}" />
                    <ComboBoxItem Tag="system" Content="{local:Loc Settings.FollowSystem}" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16 0 16 16" Padding="1" Style="{StaticResource SettingsSection}">
            <ListView x:Name="ListView"
                      Background="{DynamicResource SnoopNext.Brush.Panel}"
                      BorderThickness="0"
                      Foreground="{DynamicResource SnoopNext.Brush.Text}"
                      HorizontalContentAlignment="Stretch"
                      IsSynchronizedWithCurrentItem="True"
                      ItemsSource="{Binding ElementName=Control, Path=Properties}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource GridView.GridViewItemContainerStyle}">
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource SnoopNext.FocusVisual}" />
                        <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <GridViewRowPresenter Margin="4 0" VerticalAlignment="Center" />
                                            <Border x:Name="RecentEdit" Width="2" Height="14" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SnoopNext.Brush.Accent}" CornerRadius="1"
                                                    IsHitTestVisible="False" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SnoopNext.Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SnoopNext.Brush.Pressed}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Accent}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasChangedRecently}" Value="True">
                                            <Setter TargetName="RecentEdit" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderStyle}">
                                <Setter Property="Background" Value="{DynamicResource SnoopNext.Brush.Panel}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Padding" Value="8 0" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="206">
                            <GridViewColumn.Header>
                                <TextBlock Text="{local:Loc Property.Name}" ToolTip="{local:Loc Property.NameDescription}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="snoop:PropertyInformation">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="200" CellTemplateSelector="{DynamicResource EditorSelector}">
                            <GridViewColumn.Header>
                                <TextBlock Text="{local:Loc Property.Value}" ToolTip="{local:Loc Property.ValueDescription}" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SnoopNext.Brush.Panel}"
                BorderBrush="{DynamicResource SnoopNext.Brush.Border}"
                BorderThickness="0 1 0 0"
                Padding="16 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetAllSettings"
                        Click="ResetAllSettings_OnClick"
                        Content="{local:Loc Settings.ResetAll}"
                        Style="{StaticResource SettingsAction}" />
                <Button x:Name="DiscardSettings"
                        Grid.Column="2"
                        Margin="8 0"
                        Click="DiscardSettings_OnClick"
                        Content="{local:Loc Settings.DiscardChanges}"
                        Style="{StaticResource SettingsAction}" />
                <Button x:Name="SaveSettingsAndClose"
                        Grid.Column="3"
                        Click="SaveSettingsAndClose_OnClick"
                        Content="{local:Loc Settings.SaveAndClose}"
                        Style="{StaticResource SettingsPrimaryAction}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
