<windows:SnoopBaseWindow x:Class="Snoop.Views.AttachFailureDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
                         xmlns:windows="clr-namespace:Snoop.Windows;assembly=Snoop.Core"
                         Width="470" SizeToContent="Height" ResizeMode="NoResize"
                         ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                         FontSize="{DynamicResource SnoopNext.FontSize.UI}"
                         FontFamily="{DynamicResource SnoopNext.FontFamily.UI}">
    <Border Padding="20" Background="{DynamicResource SnoopNext.Brush.Background}">
        <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <TextBlock x:Name="FailureCaption" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="FailureGuidance" Margin="0,8,0,12" TextWrapping="Wrap" />
            <Expander Header="{local:Loc Chooser.FailureDetails}">
                <TextBox x:Name="FailureDetails" Margin="0,5,0,0" MaxHeight="150"
                         IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="{local:Loc Chooser.FailureDetails}"
                         VerticalScrollBarVisibility="Auto" />
            </Expander>
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RetryButton" MinWidth="88" MinHeight="32" Margin="0,0,8,0"
                        IsDefault="True" Content="{local:Loc Chooser.Retry}" Click="Retry_Click" />
                <Button x:Name="CloseButton" MinWidth="88" MinHeight="32"
                        IsCancel="True" Content="{local:Loc Chooser.Close}" />
            </StackPanel>
        </StackPanel>
    </Border>
</windows:SnoopBaseWindow>
