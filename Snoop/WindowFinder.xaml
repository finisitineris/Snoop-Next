<UserControl x:Class="Snoop.WindowFinder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:snoop="clr-namespace:Snoop"
             x:Name="Finder" VerticalContentAlignment="Center" Focusable="False" IsTabStop="False">
    <!-- The adjacent command and target list provide the keyboard equivalent.
         Mouse capture focuses this handle to receive Escape during a drag. -->
    <Button x:Name="btnStartWindowsSearch" Style="{DynamicResource LauncherButton}" Cursor="Cross"
            IsTabStop="False" AutomationProperties.Name="{Binding ToolTip, ElementName=Finder}">
        <Path x:Name="snoopCrosshairsImage" Width="16" Height="16" Stretch="Uniform"
              Stroke="{DynamicResource SnoopNext.Brush.Text}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Data" Value="M13,8 A5,5 0 1 1 3,8 A5,5 0 1 1 13,8 M8,1 V5 M8,11 V15 M1,8 H5 M11,8 H15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowFinderType, ElementName=Finder}" Value="{x:Static snoop:WindowFinderType.Magnify}">
                            <Setter Property="Data" Value="M5,1 H1 V5 M11,1 H15 V5 M1,11 V15 H5 M11,15 H15 V11 M9.8,7 A2.8,2.8 0 1 1 4.2,7 A2.8,2.8 0 1 1 9.8,7 M9.2,9.2 L12,12" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>
    </Button>
</UserControl>
