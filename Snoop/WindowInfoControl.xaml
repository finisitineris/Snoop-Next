<UserControl x:Class="Snoop.WindowInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Snoop.Converters"
             xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
             xmlns:snoopwpf="urn:snoopwpf"
             FontFamily="Segoe UI" FontSize="12" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
             TextOptions.TextRenderingMode="Aliased" UseLayoutRounding="True">
    <!-- Rendered off-tree into a cursor. Keep the reticle centered on the (16,20) hotspot.
         Native system brushes remain available with no resource ancestors. -->
    <StackPanel Height="40" Margin="8,0,0,0" Orientation="Horizontal">
        <Grid Width="16" Height="16" VerticalAlignment="Center">
            <Grid.Resources>
                <Geometry x:Key="Reticle">M13,8 A5,5 0 1 1 3,8 A5,5 0 1 1 13,8 M8,1 V5 M8,11 V15 M1,8 H5 M11,8 H15</Geometry>
            </Grid.Resources>
            <Path Data="{StaticResource Reticle}" Stroke="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" StrokeThickness="3" />
            <Path Data="{StaticResource Reticle}" Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" StrokeThickness="1" />
        </Grid>
        <Border x:Name="WindowInfoContainer" Visibility="Collapsed" Margin="4,0,0,0" Padding="5,2"
                VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Image Width="14" Height="14" Margin="0,0,4,0"
                       Visibility="{Binding OwningProcessInfo.IsProcessElevated, Converter={x:Static snoopwpf:BoolToVisibilityConverter.DefaultInstance}}"
                       Source="{Binding Source={x:Static infrastructure:SystemIcon.Shield}, Converter={x:Static converters:SystemIconToImageSourceConverter.Instance}, ConverterParameter=16}" />
                <TextBlock MaxWidth="180" VerticalAlignment="Center" Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
