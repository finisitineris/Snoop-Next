<Window x:Class="Snoop.AppChooser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Snoop.Converters"
        xmlns:infrastructure="clr-namespace:Snoop.Infrastructure"
        xmlns:local="clr-namespace:Snoop.Next.Localization;assembly=Snoop.Next.Localization"
        xmlns:snoop="clr-namespace:Snoop"
        xmlns:snoopwpf="urn:snoopwpf"
        x:Name="Root" Title="{local:Loc Shell.Title}" Icon="Snoop.ico"
        Width="740" MinWidth="560" Height="48" MinHeight="48"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="{DynamicResource SnoopNext.Brush.Text}" FontFamily="{DynamicResource SnoopNext.FontFamily.UI}" FontSize="13"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TargetColumn" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <AdornerDecorator>
                <ContentPresenter />
            </AdornerDecorator>
        </ControlTemplate>
    </Window.Template>
    <Border x:Name="ChooserSurface" Background="{DynamicResource SnoopNext.Brush.Background}"
            BorderBrush="{DynamicResource SnoopNext.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="7,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="46" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Background="Transparent"
                        MouseLeftButtonDown="HandleMouseLeftButtonDown">
                <Grid Width="24" Height="24" Margin="3,0,6,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SnoopNext.Brush.Accent}" CornerRadius="6" />
                    <Path Width="15" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource SnoopNext.Brush.OnAccent}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M 2,1 L 13,1 Q 14,1 14,2 L 14,8 M 6,12 L 2,12 Q 1,12 1,11 L 1,2 Q 1,1 2,1 M 1,4 L 14,4 M 7,6 L 7,13 L 9,11 L 11,14 L 13,13 L 11,10 L 14,10 Z" />
                </Grid>
                <TextBlock x:Name="BrandLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="{local:Loc Shell.Title}" />
            </StackPanel>

            <snoop:LauncherTargetPicker x:Name="windowsComboBox" Grid.Column="1" VerticalAlignment="Center"
                      Style="{StaticResource LauncherTargetList}" MaxDropDownHeight="320"
                      IsSynchronizedWithCurrentItem="True" TextSearch.TextPath="ProcessName" ItemsSource="{Binding WindowInfos}"
                      DropDownOpened="HandleWindowsComboBox_OnDropDownOpened"
                      AutomationProperties.Name="{local:Loc Chooser.SelectTarget}" AutomationProperties.ItemStatus="{Binding TargetSearch}"
                      AutomationProperties.AcceleratorKey="Ctrl+F" ToolTip="{local:Loc Chooser.SearchTip}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type snoop:WindowInfo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shield" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Pid" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Process" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="14" Height="14" Margin="0,0,4,0"
                                   Visibility="{Binding OwningProcessInfo.IsProcessElevated, Converter={x:Static snoopwpf:BoolToVisibilityConverter.DefaultInstance}}"
                                   Source="{Binding Source={x:Static infrastructure:SystemIcon.Shield}, Converter={x:Static converters:SystemIconToImageSourceConverter.Instance}, ConverterParameter=16}" />
                            <TextBlock x:Name="Pid" Grid.Column="1" Style="{StaticResource TargetColumn}" FontFamily="Consolas"
                                       Text="{Binding OwningProcessId, StringFormat={}[{0}]}"
                                       ToolTip="{local:Loc Chooser.SortPid}" MouseRightButtonUp="HandleDropDownColumn_OnMouseRightButtonUp" />
                            <TextBlock x:Name="Process" Grid.Column="2" Style="{StaticResource TargetColumn}" MaxWidth="155"
                                       Text="{Binding ProcessName}" ToolTip="{local:Loc Chooser.SortProcess}"
                                       MouseRightButtonUp="HandleDropDownColumn_OnMouseRightButtonUp" />
                            <TextBlock x:Name="Caption" Grid.Column="3" Style="{StaticResource TargetColumn}" MaxWidth="320" Text="{Binding WindowTitle}"
                                       MouseRightButtonUp="HandleDropDownColumn_OnMouseRightButtonUp">
                                <TextBlock.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WindowTitle}" />
                                        <TextBlock Text="{local:Loc Chooser.SortTitle}" />
                                    </StackPanel>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsPresenter}}" Value="1">
                                <Setter TargetName="Pid" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsPresenter}}" Value="2">
                                <Setter TargetName="Process" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsPresenter}}" Value="3">
                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </snoop:LauncherTargetPicker>

            <WrapPanel x:Name="TargetActions" Grid.Column="2" Margin="3,0,0,0" VerticalAlignment="Center">
                <Button x:Name="RefreshTargetsButton" Style="{StaticResource LauncherButton}" Command="{x:Static snoop:AppChooser.RefreshCommand}"
                        AutomationProperties.Name="{local:Loc Chooser.Refresh}" ToolTip="{local:Loc Chooser.Refresh}">
                    <Path Style="{StaticResource LauncherIcon}" Data="M14,6 A6,6 0 1 0 14,11 M14,2 L14,6.5 L9.5,6.5" />
                </Button>
                <Border Style="{StaticResource LauncherDivider}" />
                <Button x:Name="InspectTargetButton" Style="{StaticResource LauncherPrimaryButton}"
                        Command="{x:Static snoop:AppChooser.InspectCommand}" Content="{local:Loc Chooser.AttachLabel}"
                        AutomationProperties.Name="{local:Loc Chooser.Inspect}" ToolTip="{local:Loc Chooser.Inspect}" />
                <snoop:WindowFinder x:Name="InspectWindowFinder" WindowFinderType="Snoop" ToolTip="{local:Loc Chooser.PickInspect}" />
                <Border Style="{StaticResource LauncherDivider}" />
                <Button x:Name="MagnifyTargetButton" Style="{StaticResource LauncherButton}" Command="{x:Static snoop:AppChooser.MagnifyCommand}"
                        AutomationProperties.Name="{local:Loc Chooser.Magnify}" ToolTip="{local:Loc Chooser.Magnify}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LauncherIcon}" Width="14" Height="14"
                              Data="M11,6 A5,5 0 1 1 1,6 A5,5 0 1 1 11,6 M10,10 L15,15 M3.5,6 H8.5 M6,3.5 V8.5" />
                        <TextBlock Margin="5,0,0,0" Text="{local:Loc Chooser.MagnifyLabel}" />
                    </StackPanel>
                </Button>
                <snoop:WindowFinder x:Name="MagnifyWindowFinder" WindowFinderType="Magnify" ToolTip="{local:Loc Chooser.PickMagnify}" />
            </WrapPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="WindowActionsDivider" Style="{StaticResource LauncherDivider}" />
                <Button x:Name="SettingsButton" Style="{StaticResource LauncherButton}" Command="{x:Static snoop:AppChooser.SettingsCommand}"
                        AutomationProperties.Name="{local:Loc Chooser.Settings}" ToolTip="{local:Loc Chooser.Settings}">
                    <Path Style="{StaticResource LauncherIcon}" Data="M6.4,1 H9.6 L10,3 L11.3,3.8 L13.2,3.2 L14.8,5.8 L13.4,7.2 V8.8 L14.8,10.2 L13.2,12.8 L11.3,12.2 L10,13 L9.6,15 H6.4 L6,13 L4.7,12.2 L2.8,12.8 L1.2,10.2 L2.6,8.8 V7.2 L1.2,5.8 L2.8,3.2 L4.7,3.8 L6,3 Z M10.5,8 A2.5,2.5 0 1 1 5.5,8 A2.5,2.5 0 1 1 10.5,8" />
                </Button>
                <Button x:Name="MinimizeButton" Style="{StaticResource LauncherButton}" Command="{x:Static snoop:AppChooser.MinimizeCommand}"
                        AutomationProperties.Name="{local:Loc Chooser.Minimize}" ToolTip="{local:Loc Chooser.Minimize}">
                    <Path Width="10" StrokeThickness="1.2" Stroke="{DynamicResource SnoopNext.Brush.Text}" Data="M0,1 H10" />
                </Button>
                <Button x:Name="CloseButton" Command="{x:Static ApplicationCommands.Close}"
                        AutomationProperties.Name="{local:Loc Chooser.Close}" ToolTip="{local:Loc Chooser.Close}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LauncherButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SnoopNext.Brush.Error}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SnoopNext.Brush.Error}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Style="{StaticResource LauncherIcon}" Width="11" Height="11" Data="M1,1 L9,9 M9,1 L1,9" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
